CRASH-14: limit swmm_getCount/swmm_getIndex to the object types that exist

5.3.0 accepted every object type below swmm_SYSTEM (100) in swmm_getCount()
and swmm_getIndex(), but Nobjects[] and the ID hash tables Htable[] have only
MAX_OBJ_TYPES (18) entries, so a type of 18..99 read past both arrays (and
swmm_getIndex then searched a garbage hash table). Check against
MAX_OBJ_TYPES, as swmm_getName() already does, and return
ERR_API_OBJECT_TYPE for anything else.

Apply from the root of a Stormwater-Management-Model checkout at cb3e192b:
    git apply CRASH-14_swmm530.patch

diff --git a/src/legacy/engine/swmm5.c b/src/legacy/engine/swmm5.c
index 4096c9a..9bbb667 100644
--- a/src/legacy/engine/swmm5.c
+++ b/src/legacy/engine/swmm5.c
@@ -1245,7 +1245,7 @@ int EXPORT_OPENSWMMCORE_SOLVER_API swmm_getCount(int objType)
 {
     if (!IsOpenFlag)
         return 0;
-    if (objType < swmm_GAGE || objType >= swmm_SYSTEM)
+    if (objType < swmm_GAGE || objType >= MAX_OBJ_TYPES)
         return ERR_API_OBJECT_TYPE;
     return Nobjects[objType];
 }
@@ -1323,7 +1323,7 @@ int EXPORT_OPENSWMMCORE_SOLVER_API swmm_getIndex(int objType, const char *name)
 {
     if (!IsOpenFlag)
         return ERR_API_NOT_OPEN;
-    if (objType < swmm_GAGE || objType >= swmm_SYSTEM)
+    if (objType < swmm_GAGE || objType >= MAX_OBJ_TYPES)
         return ERR_API_OBJECT_TYPE;
     return project_findObject(objType, name);
 }
