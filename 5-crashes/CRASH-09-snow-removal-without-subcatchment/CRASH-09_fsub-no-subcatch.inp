[TITLE]
CRASH-09: REMOVAL sends all plowed snow to another subcatchment (Fsub = 1) but names none

;; S1 (10 ac, all impervious, all plowable) starts with 1 in of snow. Its
;; REMOVAL line gives Fsub = 1.0 and leaves out the optional receiving
;; subcatchment, so the snow pack's toSubcatch is -1. Plowing starts at the
;; first runoff step because the pack is deeper than Dplow = 0.1 in.
;; At 60 degF the pack melts within the 6-hour run. No rain, no losses.

[OPTIONS]
FLOW_UNITS       CFS
INFILTRATION     HORTON
FLOW_ROUTING     KINWAVE
START_DATE       01/01/2020
START_TIME       00:00:00
END_DATE         01/01/2020
END_TIME         06:00:00
REPORT_STEP      01:00:00
WET_STEP         00:05:00
DRY_STEP         00:05:00
ROUTING_STEP     60

[EVAPORATION]
CONSTANT 0.0

[TEMPERATURE]
TIMESERIES TEMP1
SNOWMELT 34 0.5 0.6 0 40 0

[RAINGAGES]
G1 INTENSITY 1:00 1.0 TIMESERIES RAIN1

[TIMESERIES]
RAIN1 01/01/2020 00:00 0.0
TEMP1 01/01/2020 00:00 60
TEMP1 01/02/2020 00:00 60

[SNOWPACKS]
;;Name Surface    Cmin Cmax Tbase FWF SD0 FW0 SNN0/SD100
SP1    PLOWABLE   0.05 0.05 32    0   1.0 0   1.0
SP1    IMPERVIOUS 0.05 0.05 32    0   0   0   0
SP1    PERVIOUS   0.05 0.05 32    0   0   0   0
;;Name REMOVAL    Dplow Fout Fimp Fperv Fimelt Fsub (Subcatch left out)
SP1    REMOVAL    0.1   0    0    0     0      1.0

[SUBCATCHMENTS]
;;Name Gage Outlet Area %Imperv Width %Slope CurbLen SnowPack
S1     G1   O1     10   100     500   1      0       SP1

[SUBAREAS]
S1 0.01 0.1 0 0 0 OUTLET

[INFILTRATION]
S1 0 0 4 7 0

[OUTFALLS]
O1 0 FREE

[REPORT]
SUBCATCHMENTS ALL
