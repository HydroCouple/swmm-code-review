[TITLE]
CRASH-15 one subcatchment; TSS builds up from time series TSB (EXTERNAL), LEAD by a power function

[OPTIONS]
FLOW_UNITS           CFS
INFILTRATION         HORTON
FLOW_ROUTING         KINWAVE
START_DATE           01/01/2020
START_TIME           00:00:00
REPORT_START_DATE    01/01/2020
REPORT_START_TIME    00:00:00
END_DATE             01/02/2020
END_TIME             00:00:00
WET_STEP             00:05:00
DRY_STEP             01:00:00
ROUTING_STEP         0:05:00
REPORT_STEP          01:00:00

[RAINGAGES]
G1   INTENSITY 1:00 1.0 TIMESERIES TSR

[SUBCATCHMENTS]
S1   G1   O1   10   50   500   0.5   0

[SUBAREAS]
S1   0.01  0.1  0.05  0.05  25  OUTLET

[INFILTRATION]
S1   3.0  0.5  4  7  0

[OUTFALLS]
O1   0   FREE   NO

[POLLUTANTS]
TSS   MG/L  0  0  0  0  NO
LEAD  UG/L  0  0  0  0  NO

[LANDUSES]
RES

[COVERAGES]
S1  RES  100

[BUILDUP]
;;   pollutant  function  max  scale/rate  series/exponent  normalizer
RES  TSS        EXT       50   1.0         TSB              AREA
RES  LEAD       POW       5    0.5         0.5              AREA

[WASHOFF]
RES  TSS   EXP  0.1  1
RES  LEAD  EXP  0.1  1

[TIMESERIES]
;; no rain
TSR   0:00   0
;; external TSS buildup rate (lbs/ac/day)
TSB   0:00   2.0
TSB   24:00  2.0

[REPORT]
INPUT NO
CONTROLS NO
