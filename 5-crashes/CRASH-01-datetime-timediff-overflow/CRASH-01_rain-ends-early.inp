[TITLE]
CRASH-01: a rain series that ends before the run does

[OPTIONS]
FLOW_UNITS           CFS
INFILTRATION         HORTON
FLOW_ROUTING         KINWAVE
START_DATE           01/01/2020
START_TIME           00:00:00
END_DATE             01/01/2020
END_TIME             03:00:00
REPORT_STEP          00:15:00
WET_STEP             00:05:00
DRY_STEP             01:00:00
ROUTING_STEP         60

[RAINGAGES]
;;Name  Format     Interval  SCF  Source
G1      INTENSITY  0:15      1.0  TIMESERIES  RAIN

[SUBCATCHMENTS]
;;Name  Gage  Outlet  Area  %Imperv  Width  %Slope  CurbLen
S1      G1    OUT1    10    50       500    1       0

[SUBAREAS]
;;Subcatch  N-Imperv  N-Perv  S-Imperv  S-Perv  PctZero  RouteTo
S1          0.01      0.1     0.05      0.05    25       OUTLET

[INFILTRATION]
;;Subcatch  MaxRate  MinRate  Decay  DryTime  MaxInfil
S1          3.0      0.5      4      7        0

[OUTFALLS]
;;Name  Elev  Type
OUT1    0     FREE

[TIMESERIES]
;; The series ends at 0:45. From then on the gage has no next rain date
;; (NO_DATE = 1 Jan 0001), and runoff_getTimeStep() asks for the number of
;; seconds between that date and 2020: about -6.3e10 s.
RAIN  0:00  0.5
RAIN  0:15  1.0
RAIN  0:30  0.2
RAIN  0:45  0.0

[REPORT]
SUBCATCHMENTS ALL
