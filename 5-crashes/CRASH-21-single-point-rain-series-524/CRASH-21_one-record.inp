[TITLE]
CRASH-21: a rain gage time series with a single record (1 in/hr for 1 hour)

[OPTIONS]
FLOW_UNITS       CFS
INFILTRATION     HORTON
FLOW_ROUTING     KINWAVE
START_DATE       01/01/2020
START_TIME       00:00:00
END_DATE         01/01/2020
END_TIME         01:00:00
REPORT_STEP      00:15:00
WET_STEP         00:05:00
DRY_STEP         01:00:00
ROUTING_STEP     60

[RAINGAGES]
;;Name  Format     Interval  SCF  Source
G1      INTENSITY  1:00      1.0  TIMESERIES  PULSE

[TIMESERIES]
;; one record: 1.0 in/hr from 0:00 to 1:00
PULSE  0:00  1.0

[SUBCATCHMENTS]
;;Name  Gage  Outlet  Area  %Imperv  Width  %Slope  CurbLen
S1      G1    O1      10    100      500    1       0

[SUBAREAS]
;;Subcatch  N-Imperv  N-Perv  S-Imperv  S-Perv  PctZero  RouteTo
S1          0.01      0.1     0.05      0.05    25       OUTLET

[INFILTRATION]
;;Subcatch  MaxRate  MinRate  Decay  DryTime  MaxInfil
S1          3.0      0.5      4      7        0

[OUTFALLS]
;;Name  Elev  Type
O1      0     FREE

[REPORT]
SUBCATCHMENTS ALL
