[TITLE]
IO-36: reads its RDII flows from IO-36_in.rdii, a file next to this deck

[OPTIONS]
FLOW_UNITS       CFS
INFILTRATION     HORTON
FLOW_ROUTING     KINWAVE
START_DATE       01/01/2020
START_TIME       00:00:00
END_DATE         01/01/2020
END_TIME         06:00:00
REPORT_STEP      00:15:00
WET_STEP         00:15:00
DRY_STEP         01:00:00
ROUTING_STEP     60

[FILES]
;; A relative name: it should be looked for in the folder of this .inp file,
;; not in the working directory. IO-36_test.c writes the file (node J1, 1 cfs).
USE RDII "IO-36_in.rdii"

[RAINGAGES]
;;Name  Format  Interval  SCF  Source      Series
G1      VOLUME  1:00      1.0  TIMESERIES  TS1

[TIMESERIES]
TS1  01/01/2020  00:00  1.0
TS1  01/01/2020  01:00  0.0

[HYDROGRAPHS]
UH1  G1
UH1  ALL  SHORT  0.1  1  2

[RDII]
;;Node  UHgroup  SewerArea(ac)
J1      UH1      100

[JUNCTIONS]
J1  0  10

[OUTFALLS]
O1  -1  FREE

[CONDUITS]
C1  J1  O1  100  0.01  0  0

[XSECTIONS]
C1  CIRCULAR  2  0  0  0  1
