[TITLE]
IO-45: runoff run that saves a runoff interface file

[OPTIONS]
FLOW_UNITS           CFS
INFILTRATION         HORTON
FLOW_ROUTING         KINWAVE
START_DATE           06/01/2020
START_TIME           00:00:00
REPORT_START_DATE    06/01/2020
REPORT_START_TIME    00:00:00
END_DATE             06/03/2020
END_TIME             00:00:00
WET_STEP             00:05:00
DRY_STEP             01:00:00
REPORT_STEP          01:00:00
ROUTING_STEP         0:00:30

[EVAPORATION]
;; potential evaporation 0.2 in/day
CONSTANT         0.2

[RAINGAGES]
G1   INTENSITY 1:00 1.0 TIMESERIES R1

[SUBCATCHMENTS]
;;Name  Gage  Outlet  Area  %Imperv  Width  %Slope  CurbLen
S1      G1    O1      10    100      500    1.0     0

[SUBAREAS]
;;Name  N-Imperv  N-Perv  S-Imperv  S-Perv  PctZero  RouteTo
S1      0.01      0.1     0.2       0.2     0        OUTLET

[INFILTRATION]
S1      3.0       0.5     4         7       0

[OUTFALLS]
O1      0   FREE

[TIMESERIES]
;; 0.5 in of rain in the first hour; 0.2 in stays in depression storage
R1   06/01/2020 00:00   0.5
R1   06/01/2020 01:00   0.0

[REPORT]
SUBCATCHMENTS ALL

[FILES]
SAVE RUNOFF  IO-45.rof
