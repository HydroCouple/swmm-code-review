[TITLE]
IO-14 steep pipe into a mild one, no culvert code (column 8 = 0)

[OPTIONS]
FLOW_UNITS          CFS
FLOW_ROUTING        DYNWAVE
NORMAL_FLOW_LIMITED BOTH
START_DATE          01/01/2020
START_TIME          00:00:00
END_DATE            01/01/2020
END_TIME            02:00:00
REPORT_STEP         00:05:00
ROUTING_STEP        2

[JUNCTIONS]
;Name  Elev  MaxDepth  InitDepth  SurDepth  Aponded
J1     100   10        0          0         0
J2     90    10        0          0         0

[OUTFALLS]
O1     89.5  FREE

[CONDUITS]
;Name  From  To  Length  N      Z1  Z2  Q0  Qmax
;C1 is steep (5 %), C2 is mild (0.1 %)
C1     J1    J2  200     0.013  0   0   0   0
C2     J2    O1  500     0.013  0   0   0   0

[XSECTIONS]
;Link  Shape     Geom1  Geom2  Geom3  Geom4  Barrels  Culvert
;C1 is an ordinary conduit
C1     CIRCULAR  3      0      0      0      1        0
C2     CIRCULAR  4      0      0      0      1        0

[INFLOWS]
J1     FLOW  ""  FLOW  1.0  1.0  30

[REPORT]
INPUT  YES
NODES  ALL
LINKS  ALL
