[TITLE]
IO-16: a flap gate given in [LOSSES], placed above [CONDUITS]

[OPTIONS]
FLOW_UNITS           CFS
FLOW_ROUTING         DYNWAVE
START_DATE           01/01/2020
START_TIME           00:00:00
END_DATE             01/01/2020
END_TIME             01:00:00
REPORT_STEP          00:15:00
ROUTING_STEP         10

[JUNCTIONS]
;;Name  Elev  MaxDepth  InitDepth  SurDepth  Aponded
J1      100   10        0          0         0

[OUTFALLS]
;; The outfall stage is 2 ft above J1's invert. With the flap gate on C1
;; nothing flows back: J1 stays dry and C1 carries no flow.
;;Name  Elev  Type   Stage
O1      99    FIXED  102

[LOSSES]
;; Sections may appear in any order; this one comes before [CONDUITS].
;;Link  Kentry  Kexit  Kavg  FlapGate
C1      0       0      0     YES

[CONDUITS]
;;Name  From  To  Length  Roughness  InOffset  OutOffset  InitFlow
C1      J1    O1  400     0.013      0         0         0

[XSECTIONS]
;;Link  Shape     Geom1  Geom2  Geom3  Geom4  Barrels
C1      CIRCULAR  1.5    0      0      0      1

[REPORT]
NODES ALL
LINKS ALL
