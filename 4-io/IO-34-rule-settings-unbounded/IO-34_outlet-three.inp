[TITLE]
IO-34: a numeric outlet setting of 3
;; An outlet setting lies in 0..1; 5.2.4 and 5.3.0 reject this rule with
;; ERROR 211 (invalid number).

[OPTIONS]
FLOW_UNITS           CFS
FLOW_ROUTING         DYNWAVE
START_DATE           01/01/2020
START_TIME           00:00:00
REPORT_START_DATE    01/01/2020
REPORT_START_TIME    00:00:00
END_DATE             01/01/2020
END_TIME             03:00:00
ROUTING_STEP         30
RULE_STEP            0
REPORT_STEP          00:05:00
VARIABLE_STEP        0

[JUNCTIONS]
;;Name Elev MaxDepth InitDepth SurDepth Aponded
J1     100  10       2         0        0
J2     99   10       0         0        0
J3     100  10       0         0        0
J4     99   10       0         0        0

[OUTFALLS]
O1     97   FREE     NO
O2     97   FREE     NO

[OUTLETS]
;;Name From To Offset Type             Coeff Expon FlapGate
OL1    J1   J2  0      FUNCTIONAL/DEPTH 1.0   0.5   NO

[PUMPS]
;;Name From To Curve Status Startup Shutoff
P1     J3   J4  *     ON     0       0

[CONDUITS]
C1     J2   O1  400   0.013  0  0  0  0
C2     J4   O2  400   0.013  0  0  0  0

[XSECTIONS]
C1     CIRCULAR     1.5  0    0  0  1
C2     CIRCULAR     1.5  0    0  0  1

[INFLOWS]
J1     FLOW  ""  FLOW  1.0  1.0  2.0
J3     FLOW  ""  FLOW  1.0  1.0  1.0

[CONTROLS]
RULE OL3
IF SIMULATION TIME > 1
THEN OUTLET OL1 SETTING = 3

[REPORT]
INPUT NO
CONTROLS YES
