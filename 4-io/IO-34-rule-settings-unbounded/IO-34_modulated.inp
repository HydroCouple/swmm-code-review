[TITLE]
IO-34: TIMESERIES-modulated settings outside the valid range
;; Outlet OL1 (q = 1.0*h^0.5) follows series TSSET: 1, then 3 from 1:01, then
;; -0.5 from 2:01. Ideal pump P1 follows series TSPUMP: 1, then -1 from 2:01.
;; An outlet setting lies in 0..1 and a pump setting cannot be negative.

[OPTIONS]
FLOW_UNITS           CFS
FLOW_ROUTING         DYNWAVE
START_DATE           01/01/2020
START_TIME           00:00:00
REPORT_START_DATE    01/01/2020
REPORT_START_TIME    00:00:00
END_DATE             01/01/2020
END_TIME             03:00:00
ROUTING_STEP         30
RULE_STEP            0
REPORT_STEP          00:05:00
VARIABLE_STEP        0

[JUNCTIONS]
;;Name Elev MaxDepth InitDepth SurDepth Aponded
J1     100  10       2         0        0
J2     99   10       0         0        0
J3     100  10       0         0        0
J4     99   10       0         0        0

[OUTFALLS]
O1     97   FREE     NO
O2     97   FREE     NO

[OUTLETS]
;;Name From To Offset Type             Coeff Expon FlapGate
OL1    J1   J2  0      FUNCTIONAL/DEPTH 1.0   0.5   NO

[PUMPS]
;;Name From To Curve Status Startup Shutoff
P1     J3   J4  *     ON     0       0

[CONDUITS]
C1     J2   O1  400   0.013  0  0  0  0
C2     J4   O2  400   0.013  0  0  0  0

[XSECTIONS]
C1     CIRCULAR     1.5  0    0  0  1
C2     CIRCULAR     1.5  0    0  0  1

[INFLOWS]
J1     FLOW  ""  FLOW  1.0  1.0  2.0
J3     FLOW  ""  FLOW  1.0  1.0  1.0

[CONTROLS]
RULE TSO
IF SIMULATION TIME > 0
THEN OUTLET OL1 SETTING = TIMESERIES TSSET

RULE TSP
IF SIMULATION TIME > 0
THEN PUMP P1 SETTING = TIMESERIES TSPUMP

[TIMESERIES]
TSSET   0:00  1.0
TSSET   1:00  1.0
TSSET   1:01  3.0
TSSET   2:00  3.0
TSSET   2:01  -0.5
TSSET   3:00  -0.5
TSPUMP  0:00  1.0
TSPUMP  2:00  1.0
TSPUMP  2:01  -1.0
TSPUMP  3:00  -1.0

[REPORT]
INPUT NO
CONTROLS YES
