[TITLE]
IO-18: [SUBAREAS] PctZero of 150 percent

[OPTIONS]
;; 10 ac, 50 % impervious. PctZero is the percent of the impervious area
;; with no depression storage, so it must lie between 0 and 100. With 150
;; the IMPERV1 sub-area gets an area fraction of 0.5 x (1 - 1.5) = -0.25.
FLOW_UNITS           CFS
INFILTRATION         HORTON
FLOW_ROUTING         KINWAVE
START_DATE           01/01/2020
START_TIME           00:00:00
REPORT_START_DATE    01/01/2020
REPORT_START_TIME    00:00:00
END_DATE             01/01/2020
END_TIME             06:00:00
WET_STEP             00:01:00
DRY_STEP             00:01:00
ROUTING_STEP         60
REPORT_STEP          00:15:00

[RAINGAGES]
;;Name  Format     Interval  SCF  Source
G1      INTENSITY  0:15      1.0  TIMESERIES  RAIN

[SUBCATCHMENTS]
;;Name  Gage  Outlet  Area  %Imperv  Width  %Slope  CurbLen
S1      G1    O1      10    50       500    1       0

[SUBAREAS]
;;Subcatch  N-Imperv  N-Perv  S-Imperv  S-Perv  PctZero  RouteTo
S1          0.012     0.15    0.1       0.2     150      OUTLET

[INFILTRATION]
;;Subcatch  MaxRate  MinRate  Decay  DryTime  MaxInfil
S1          3        0.5      4      7        0

[OUTFALLS]
;;Name  Elev  Type  Gated
O1      0     FREE  NO

[TIMESERIES]
;; 1 in/hr for 15 min: 0.25 in of rain
RAIN  01/01/2020 00:00  1.0
RAIN  01/01/2020 01:00  0.0
