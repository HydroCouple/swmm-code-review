[TITLE]
IO-20: [SUBAREAS] with a non-numeric N-Perv

[OPTIONS]
;; N-Perv is "abc". It must be reported as an invalid number (ERROR 211).
FLOW_UNITS           CFS
INFILTRATION         HORTON
FLOW_ROUTING         KINWAVE
START_DATE           01/01/2020
START_TIME           00:00:00
REPORT_START_DATE    01/01/2020
REPORT_START_TIME    00:00:00
END_DATE             01/01/2020
END_TIME             03:00:00
WET_STEP             00:05:00
DRY_STEP             01:00:00
REPORT_STEP          00:05:00
ROUTING_STEP         0:00:30
IGNORE_ROUTING       YES

[EVAPORATION]
CONSTANT         0.0

[RAINGAGES]
;;Name  Format     Interval  SCF  Source
G1      INTENSITY  1:00      1.0  TIMESERIES  R1

[SUBCATCHMENTS]
;;Name  Gage  Outlet  Area  %Imperv  Width  %Slope  CurbLen
S1      G1    O1      1.0   0        100    1.0     0

[SUBAREAS]
;;Subcatch  N-Imperv  N-Perv  S-Imperv  S-Perv  PctZero  RouteTo
S1          0.01      abc     0.05      0.5     25       OUTLET

[INFILTRATION]
;;Subcatch  MaxRate  MinRate  Decay  DryTime  MaxInfil
S1          0.0      0.0      4      7        0

[OUTFALLS]
;;Name  Elev  Type
O1      0     FREE

[TIMESERIES]
;; 0.9 in/hr for one hour
R1   0:00   0.9
R1   1:00   0.0

[REPORT]
SUBCATCHMENTS ALL
