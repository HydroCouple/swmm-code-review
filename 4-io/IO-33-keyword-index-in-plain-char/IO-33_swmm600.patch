         FileMode mode = FileMode::NONE;
         if      (mode_word == "SAVE") mode = FileMode::SAVE;
         else if (mode_word == "USE")  mode = FileMode::USE;
-        else continue;  // unrecognised mode — skip silently (legacy behaviour)
+        else {
+            // NO and SCRATCH name no file; any other word is ERROR 205, as in
+            // legacy iface_readFileParams() (findmatch() matches a prefix)
+            if (mode_word.rfind("NO", 0) != 0 && mode_word.rfind("SCRATCH", 0) != 0 &&
+                mode_word.rfind("USE", 0) != 0 && mode_word.rfind("SAVE", 0) != 0)
+                ctx.errors.push_back(format_error(ERR_KEYWORD, tok[0]));
+            continue;
+        }
 
         if (kind_word == "RAINFALL") {
             files.rainfall_mode = mode;
@@ -108,9 +115,12 @@ void handle_files(SimulationContext& ctx, const std::vector<std::string>& lines)
             } else {  // USE
                 files.hotstart_use_path = path;
             }
+        } else if (kind_word.rfind("RAINFALL", 0) != 0 && kind_word.rfind("RUNOFF", 0) != 0 &&
+                   kind_word.rfind("HOTSTART", 0) != 0 && kind_word.rfind("RDII", 0) != 0 &&
+                   kind_word.rfind("INFLOWS", 0) != 0 && kind_word.rfind("OUTFLOWS", 0) != 0) {
+            // legacy iface_readFileParams(): an unknown file type is ERROR 205
+            ctx.errors.push_back(format_error(ERR_KEYWORD, tok[1]));
         }
-        // Unknown kinds are silently ignored — preserves the legacy
