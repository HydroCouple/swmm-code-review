[TITLE]
IO-59: a trunk sewer carrying a constant 150,000 GPM (334 cfs)

[OPTIONS]
FLOW_UNITS           GPM
FLOW_ROUTING         DYNWAVE
START_DATE           01/01/2020
START_TIME           00:00:00
END_DATE             01/01/2020
END_TIME             02:00:00
REPORT_STEP          00:15:00
ROUTING_STEP         5

[JUNCTIONS]
;;Name  Elev  MaxDepth  InitDepth  SurDepth  Aponded
J1      100   10        0          0         0

[OUTFALLS]
O1      90    FREE

[CONDUITS]
;;Name  From  To  Length  Roughness  InOffset  OutOffset  InitFlow
C1      J1    O1  1000    0.013      0         0          150000

[XSECTIONS]
;;Link  Shape     Geom1  Geom2  Geom3  Geom4  Barrels
C1      CIRCULAR  6      0      0      0      1

[INFLOWS]
;;Node  Constituent  TimeSeries  Type  Mfactor  Sfactor  Baseline
J1      FLOW         ""          FLOW  1.0      1.0      150000

[REPORT]
INPUT     NO
CONTROLS  NO
