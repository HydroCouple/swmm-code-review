@@ -333,6 +333,7 @@ void StructureSolver::computePumpFlowK(SimulationContext& ctx, double dt,
         // NOTE: pump startup/shutoff hysteresis is evaluated ONCE per timestep
         // in updatePumpTargetSettings(), NOT here inside the DW iteration loop.
         links.setting[uj] = links.target_setting[uj];
+        links.flow_class[uj] = FlowClass::DRY;   // on its curve (legacy NO)
 
         // If pump is off, no flow
         if (links.setting[uj] == 0.0) {
@@ -401,6 +402,20 @@ void StructureSolver::computePumpFlowK(SimulationContext& ctx, double dt,
                 break;
         }
 
+        // Off-curve operation for the Pumping Summary (legacy pump_getInflow):
+        // DN_DRY below the curve's first x, UP_DRY above its last
+        if (ct >= 1 && ct <= 5 && ci >= 0 && uci < ctx.tables.tables.size() &&
+            !ctx.tables.tables[uci].x.empty()) {
+            double xc = depth * ucf_len;
+            if (ct == 1) xc = nodes.volume[un1] * ucf_vol;
+            if (ct == 3 || ct == 5) {
+                double s = (ct == 5) ? links.setting[uj] : 1.0;
+                xc = std::max(head / (s * s), 0.0) * ucf_len;
+            }
+            if (xc < ctx.tables.tables[uci].x.front()) links.flow_class[uj] = FlowClass::DN_DRY;
+            if (xc > ctx.tables.tables[uci].x.back())  links.flow_class[uj] = FlowClass::UP_DRY;
+        }
