[TITLE]
IO-40: junction J1 takes 1 cfs carrying TSS = 10, TP = 20 and COD = 40 mg/L.
TP C = (TSS)-1 and COD C = (TSS+2)-3 are both 9 mg/L: a minus sign
directly after a closing parenthesis is a subtraction.

[OPTIONS]
FLOW_UNITS           CFS
FLOW_ROUTING         KINWAVE
START_DATE           01/01/2020
START_TIME           00:00:00
REPORT_START_DATE    01/01/2020
REPORT_START_TIME    00:00:00
END_DATE             01/01/2020
END_TIME             01:00:00
DRY_STEP             00:05:00
WET_STEP             00:05:00
ROUTING_STEP         30
REPORT_STEP          00:15:00

[JUNCTIONS]
;;Name  Elev  MaxDepth  InitDepth  SurDepth  Aponded
J1      2     5         0          0         0

[OUTFALLS]
;;Name  Elev  Type
O1      0     FREE

[CONDUITS]
;;Name  From  To  Length  Roughness  InOffset  OutOffset  InitFlow
C1      J1    O1  400     0.013      0         0          0

[XSECTIONS]
;;Link  Shape     Geom1  Geom2  Geom3  Geom4  Barrels
C1      CIRCULAR  1      0      0      0      1

[POLLUTANTS]
;;Name  Units  Crain  Cgw  Crdii  Kdecay  SnowOnly  CoPollut  CoFrac  Cdwf  Cinit
TSS     MG/L   0      0    0      0       NO        *         0       0     0
TP      MG/L   0      0    0      0       NO        *         0       0     0
COD     MG/L   0      0    0      0       NO        *         0       0     0

[DWF]
;;Node  Constituent  Baseline
J1      FLOW         1
J1      TSS          10
J1      TP           20
J1      COD          40

[TREATMENT]
;;Node  Pollutant  Function
J1      TP         C = (TSS)-1
J1      COD        C = (TSS+2)-3

[REPORT]
NODES ALL
LINKS ALL
