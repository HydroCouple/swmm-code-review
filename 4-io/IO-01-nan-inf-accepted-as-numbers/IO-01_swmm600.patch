IO-01: reject "nan" and "inf" as numeric input

openswmm::from_chars_double() (std::from_chars, or strtod_l on the fallback
path) reads "nan", "inf" and "infinity" as numbers, so they reached the model
from every section. It now reports a non-finite result as invalid_argument,
which every parser in the input reader already handles as "not a number".

Most section handlers read numbers with to_double(), which turns an
unreadable token into 0.0 without a message (legacy reports ERROR 211). For
the fields this issue's test uses, the handlers now check the token with
parse_double_strict() and report ERROR 211 as legacy does: junction max /
initial / surcharge depth and ponded area, conduit length and roughness, and
time series values. ROUTING_STEP already rejects an unreadable step.

Apply from the root of a Stormwater-Management-Model checkout at cb3e192b:
    git apply IO-01_swmm600.patch

diff --git a/src/engine/core/charconv_compat.hpp b/src/engine/core/charconv_compat.hpp
index 707deaa..71bf484 100644
--- a/src/engine/core/charconv_compat.hpp
+++ b/src/engine/core/charconv_compat.hpp
@@ -18,6 +18,7 @@
 #define OPENSWMM_CHARCONV_COMPAT_HPP
 
 #include <charconv>
+#include <cmath>
 #include <cstdlib>
 #include <cstring>
 #include <system_error>
@@ -71,7 +72,13 @@ inline std::from_chars_result from_chars_double(const char* first,
                                                 const char* last,
                                                 double& value) noexcept {
 #if defined(__cpp_lib_to_chars) && __cpp_lib_to_chars >= 201611L
-    return std::from_chars(first, last, value);
+    // from_chars also reads "nan", "inf" and "infinity": not valid input
+    double v = 0.0;
+    const std::from_chars_result r = std::from_chars(first, last, v);
+    if (r.ec != std::errc{}) return r;
+    if (!std::isfinite(v)) return {first, std::errc::invalid_argument};
+    value = v;
+    return r;
 #else
     if (first == last) {
         return {first, std::errc::invalid_argument};
@@ -103,7 +110,7 @@ inline std::from_chars_result from_chars_double(const char* first,
         v = std::strtod(cstr, &end);
     }
 
-    if (end == cstr) {
+    if (end == cstr || !std::isfinite(v)) {
         return {first, std::errc::invalid_argument};
     }
     value = v;
diff --git a/src/engine/input/handlers/LinksHandler.cpp b/src/engine/input/handlers/LinksHandler.cpp
index c205c9e..fca6649 100644
--- a/src/engine/input/handlers/LinksHandler.cpp
+++ b/src/engine/input/handlers/LinksHandler.cpp
@@ -112,6 +112,15 @@ void handle_conduits(SimulationContext& ctx, const std::vector<std::string>& lin
         const auto ucr = static_cast<std::size_t>(cr);
 
         set_link_nodes(ctx, idx, tok[1], tok[2]);
+        // Length and roughness that are not numbers (e.g. "nan") are
+        // ERROR 211, as in legacy conduit_readParams.
+        double v = 0.0;
+        const std::size_t bad = !parse_double_strict(tok[3], v) ? 3
+                              : !parse_double_strict(tok[4], v) ? 4 : 0;
+        if (bad != 0) {
+            ctx.errors.push_back(format_error(ERR_NUMBER, tok[bad]));
+            continue;
+        }
         ctx.link_subtypes.conduits.length[ucr]    = to_double(tok[3]);
         ctx.link_subtypes.conduits.roughness[ucr] = to_double(tok[4]);
         ctx.links.offset1[idx]   = offsetToken(ctx, tok[5]);
