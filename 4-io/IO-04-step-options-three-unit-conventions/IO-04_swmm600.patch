             openswmm::from_chars_double(val.data(), val.data() + val.size(), opt.dry_days);
         } else if (key == "DRY_STEP") {
-            const double step = parse_time_seconds(val);
+            double h = 0.0;   // a bare number is decimal hours, as in legacy
+            const double step = parse_double_strict(val, h)
+                ? std::floor(h / 24.0 * 86400.0 + 0.5) : clock_seconds(val);
             if (!(step > 0.0 && step < 2147483647.0)) {  // legacy: ERROR 211
                 ctx.errors.push_back(format_error(ERR_NUMBER, val));
                 continue;
             }
