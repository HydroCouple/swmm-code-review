[TITLE]
IO-17: the reference model with [SUBAREAS] above [SUBCATCHMENTS]

[OPTIONS]
FLOW_UNITS           CFS
INFILTRATION         HORTON
FLOW_ROUTING         KINWAVE
START_DATE           01/01/2020
START_TIME           00:00:00
END_DATE             01/01/2020
END_TIME             06:00:00
WET_STEP             00:01:00
DRY_STEP             00:01:00
ROUTING_STEP         60
REPORT_STEP          00:15:00

[RAINGAGES]
;;Name  Format     Interval  SCF  Source
G1      INTENSITY  0:15      1.0  TIMESERIES  RAIN

[SUBAREAS]
;;Subcatch  N-Imperv  N-Perv  S-Imperv  S-Perv  PctZero  RouteTo   PctRouted
S1          0.012     0.15    0.1       0.2     25       PERVIOUS  50

[SUBCATCHMENTS]
;;Name  Gage  Outlet  Area  %Imperv  Width  %Slope  CurbLen
S1      G1    O1      10    50       500    1       0

[INFILTRATION]
;;Subcatch  MaxRate  MinRate  Decay  DryTime  MaxInfil
S1          3        0.5      4      7        0

[PATTERNS]
;;Name  Type     Factors
HALF    MONTHLY  0.5 0.5 0.5 0.5 0.5 0.5
HALF             0.5 0.5 0.5 0.5 0.5 0.5

[ADJUSTMENTS]
;; halve S1's pervious n, depression storage and infiltration rate
N-PERV  S1  HALF
DSTORE  S1  HALF
INFIL   S1  HALF

[OUTFALLS]
;;Name  Elev  Type  Gated
O1      0     FREE  NO

[TIMESERIES]
;;Name  Date        Time   Value
RAIN    01/01/2020  00:00  1.0
RAIN    01/01/2020  00:15  1.0
RAIN    01/01/2020  00:30  1.0
RAIN    01/01/2020  00:45  1.0
RAIN    01/01/2020  01:00  0.0
