[TITLE]
IO-38: outfall stages from external files that differ only in the final newline

[OPTIONS]
FLOW_UNITS           CFS
FLOW_ROUTING         DYNWAVE
START_DATE           01/01/2020
START_TIME           00:00:00
END_DATE             01/01/2020
END_TIME             03:00:00
REPORT_STEP          00:15:00
ROUTING_STEP         10

[JUNCTIONS]
;;Name  Elev  MaxDepth  InitDepth  SurDepth  Aponded
J1      100   5         0          0         0
J2      100   5         0          0         0

[OUTFALLS]
;; Both stage series hold 99.5 / 100.5 / 101.5 ft at 0:00 / 1:00 / 2:00.
;; After 2:00 the last value, 101.5 ft, applies (a depth of 2.5 ft).
;;Name  Elev  Type        Stage data
O1      99    TIMESERIES  STG_NO_NEWLINE
O2      99    TIMESERIES  STG_NEWLINE

[CONDUITS]
;;Name  From  To  Length  Roughness  InOffset  OutOffset  InitFlow
C1      J1    O1  400     0.013      0         0         0
C2      J2    O2  400     0.013      0         0         0

[XSECTIONS]
;;Link  Shape     Geom1  Geom2  Geom3  Geom4  Barrels
C1      CIRCULAR  3      0      0      0      1
C2      CIRCULAR  3      0      0      0      1

[INFLOWS]
;; 1 cfs baseline: critical depth in the conduits stays below 0.5 ft, so the
;; outfall depth is always the stage minus the outfall invert.
;;Node  Constituent  Tseries  Type  Mfactor  Sfactor  Baseline
J1      FLOW         ""       FLOW  1.0      1.0      1.0
J2      FLOW         ""       FLOW  1.0      1.0      1.0

[TIMESERIES]
;; The last line of IO-38_stage-no-newline.dat has no line break;
;; IO-38_stage-newline.dat holds the same lines and ends with one.
STG_NO_NEWLINE  FILE  "IO-38_stage-no-newline.dat"
STG_NEWLINE     FILE  "IO-38_stage-newline.dat"

[REPORT]
NODES ALL
