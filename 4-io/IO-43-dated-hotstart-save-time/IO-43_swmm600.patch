IO-43: write dated SAVE HOTSTART files during the run

[FILES] SAVE HOTSTART <file> <date> <time> was parsed, but the only hot start
save was the one in end(), which skips every row with a date, so no file was
written and nothing was reported. Write each dated file in step(), at the
first step that reaches its date (the date of the current routing time, with
legacy getDateTime()'s 1 ms offset), in the same format as the end-of-run
save. A row whose date is at or before the start is written after the first
step, as in legacy.

Apply from the root of a Stormwater-Management-Model checkout at cb3e192b:
    git apply IO-43_swmm600.patch

diff --git a/src/engine/core/SWMMEngine.cpp b/src/engine/core/SWMMEngine.cpp
index 839529d..8883d00 100644
--- a/src/engine/core/SWMMEngine.cpp
+++ b/src/engine/core/SWMMEngine.cpp
@@ -1714,6 +1714,7 @@ int SWMMEngine::step(double* elapsed_time) noexcept {
     ctx_.forcing.clear_reset_entries();
 
     // Advance clock (must happen before output_due check)
+    const double hs_prev_ms = ctx_.elapsed_ms;   // for dated SAVE HOTSTART below
     hydraulics::TimestepController::advance(ctx_, dt_next);
 
     // Advance the control-rule clock when the step landed on its grid
@@ -1752,6 +1753,33 @@ int SWMMEngine::step(double* elapsed_time) noexcept {
         accumulateAvgResults();
     }
 
+    // SAVE HOTSTART <file> <date> <time>: write the routing state at the first
+    // step that reaches the date, as legacy hotstart_save() does after each
+    // swmm_step (it compares getDateTime(NewRoutingTime) with the date).
+    for (const auto& entry : ctx_.files.hotstart_saves) {
+        if (entry.datetime == 0.0) continue;   // end-of-run save, see end()
+        const double now  = datetime::addSeconds(ctx_.options.start_date,
+                                                 (ctx_.elapsed_ms + 1.0) / 1000.0);
+        const double prev = datetime::addSeconds(ctx_.options.start_date,
+                                                 (hs_prev_ms + 1.0) / 1000.0);
+        if (now < entry.datetime || (hs_prev_ms > 0.0 && prev >= entry.datetime))
+            continue;                          // not reached, or written before
+        const std::string& sp = !entry.path.absolute.empty()
+            ? entry.path.absolute : entry.path.original;
+        if (sp.empty()) continue;
+        const bool lid_restart = std::any_of(ctx_.node_subtypes.storages.lid.begin(), ctx_.node_subtypes.storages.lid.end(),
+            [](const auto& c) { return c.control >= 0; });
+        int rc = 0;
+        if (lid_restart) {
+            std::unique_ptr<HotStartFile> hs(HotStartManager::save(ctx_, sp));
+            rc = hs ? 0 : 1;
+        } else rc = HotStartManager::save_legacy_routing(sp, ctx_);
+        if (rc != 0) {
+            ctx_.warnings.push_back(
+                "SAVE HOTSTART: " + HotStartManager::last_io_error());
+        }
+    }
+
     // Fire step-end callback
     if (callbacks_.on_step_end) {
         callbacks_.on_step_end(
@@ -7402,11 +7430,11 @@ int SWMMEngine::end() noexcept {
 
     // SAVE HOTSTART (end-of-run entries): write the final routing state to each
     // SAVE HOTSTART file with no datetime suffix, matching legacy swmm_end →
-    // hotstart_save (swmm5.c). Datetime-suffixed intermediate saves are a
-    // follow-up (not exercised by the QA suite). Legacy .hsf format so the file
+    // hotstart_save (swmm5.c). Datetime-suffixed saves are written by step()
+    // when their date is reached. Legacy .hsf format so the file
     // round-trips through USE HOTSTART (apply_legacy_routing).
     for (const auto& entry : ctx_.files.hotstart_saves) {
-        if (entry.datetime != 0.0) continue;   // intermediate save — not yet
+        if (entry.datetime != 0.0) continue;   // dated save, written by step()
         const std::string& sp = !entry.path.absolute.empty()
             ? entry.path.absolute : entry.path.original;
         if (sp.empty()) continue;
