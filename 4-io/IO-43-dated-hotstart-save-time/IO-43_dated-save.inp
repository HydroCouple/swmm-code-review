[TITLE]
IO-43: save a hot start file at 03:00 of a 6-hour run

[OPTIONS]
FLOW_UNITS           CFS
FLOW_ROUTING         DYNWAVE
START_DATE           01/01/2020
START_TIME           00:00:00
REPORT_START_DATE    01/01/2020
REPORT_START_TIME    00:00:00
END_DATE             01/01/2020
END_TIME             06:00:00
REPORT_STEP          00:15:00
ROUTING_STEP         5
WET_STEP             00:05:00
DRY_STEP             01:00:00

[JUNCTIONS]
;;Name  Elev  MaxDepth  InitDepth  SurDepth  Aponded
J1      100   10        0          0         0
J2      99    10        0          0         0

[OUTFALLS]
O1      98    FREE      NO

[CONDUITS]
;;Name  From  To  Length  Roughness  InOffset  OutOffset  InitFlow  MaxFlow
C1      J1    J2  400     0.013      0         0          0         0
C2      J2    O1  400     0.013      0         0          0         0

[XSECTIONS]
C1      CIRCULAR  2  0  0  0  1
C2      CIRCULAR  2  0  0  0  1

[INFLOWS]
J1      FLOW  RAMP  FLOW  1.0  1.0

[TIMESERIES]
;; inflow ramps from 0 to 12 cfs over 6 hours
RAMP    01/01/2020  00:00  0.0
RAMP    01/01/2020  06:00  12.0

[REPORT]
NODES ALL
LINKS ALL

[FILES]
;; 5.3.0 form: write the file when the run reaches 01/01/2020 03:00:00
SAVE HOTSTART  IO-43_0300.hsf  01/01/2020  03:00:00
