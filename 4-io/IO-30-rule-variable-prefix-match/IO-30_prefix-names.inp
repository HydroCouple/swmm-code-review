[TITLE]
IO-30: named variables and expressions whose names start with another name
;; SU1 and SU2 are isolated storage units held at 1 ft and 3 ft.
;; D1 and D10 are their depths; H = D1 = 1, H2 = 5*D1 = 5, G = D10 = 3.
;; Each rule's premise is true, so OR1, OR2 and OR3 should all go to 0.5.

[OPTIONS]
FLOW_UNITS           CFS
FLOW_ROUTING         DYNWAVE
START_DATE           01/01/2020
START_TIME           00:00:00
REPORT_START_DATE    01/01/2020
REPORT_START_TIME    00:00:00
END_DATE             01/01/2020
END_TIME             00:10:00
ROUTING_STEP         30
RULE_STEP            0
REPORT_STEP          00:05:00
VARIABLE_STEP        0

[JUNCTIONS]
;;Name Elev MaxDepth InitDepth SurDepth Aponded
J1     100  10       0         0        0
J2     100  10       0         0        0
J3     100  10       0         0        0

[STORAGE]
;;Name Elev MaxDepth InitDepth Shape      Coeff Expon Const
SU1    90   10       1         FUNCTIONAL 0     0     100   0  0
SU2    90   10       3         FUNCTIONAL 0     0     100   0  0

[OUTFALLS]
O1     97   FREE     NO
O2     97   FREE     NO
O3     97   FREE     NO

[ORIFICES]
OR1    J1   O1  SIDE  0  0.65  NO  0
OR2    J2   O2  SIDE  0  0.65  NO  0
OR3    J3   O3  SIDE  0  0.65  NO  0

[XSECTIONS]
OR1    RECT_CLOSED  1.0  1.0  0  0
OR2    RECT_CLOSED  1.0  1.0  0  0
OR3    RECT_CLOSED  1.0  1.0  0  0

[INFLOWS]
J1     FLOW  ""  FLOW  1.0  1.0  1.0
J2     FLOW  ""  FLOW  1.0  1.0  1.0
J3     FLOW  ""  FLOW  1.0  1.0  1.0

[CONTROLS]
VARIABLE D1 = NODE SU1 DEPTH
VARIABLE D10 = NODE SU2 DEPTH
EXPRESSION H = D1
EXPRESSION H2 = 5 * D1
EXPRESSION G = D10

;; variable D10 (3 ft) in a premise
RULE RV
IF D10 > 2
THEN ORIFICE OR1 SETTING = 0.5

;; expression H2 (5) in a premise
RULE RE
IF H2 > 2
THEN ORIFICE OR2 SETTING = 0.5

;; variable D10 inside an expression formula (G = 3)
RULE RG
IF G > 2
THEN ORIFICE OR3 SETTING = 0.5

[REPORT]
INPUT NO
CONTROLS YES
