[TITLE]
CON-20: vegetative swale in a 100 % impervious subcatchment, Horton f = 1 in/hr

[OPTIONS]
FLOW_UNITS       CFS
INFILTRATION     HORTON
FLOW_ROUTING     KINWAVE
START_DATE       01/01/2020
START_TIME       00:00:00
END_DATE         01/01/2020
END_TIME         04:00:00
REPORT_STEP      00:15:00
WET_STEP         00:01:00
DRY_STEP         00:01:00
ROUTING_STEP     60

[EVAPORATION]
CONSTANT 0.0

[RAINGAGES]
;;Name  Format     Interval  SCF  Source
G1      INTENSITY  1:00      1.0  TIMESERIES  TS1

[TIMESERIES]
;; 3 in/hr for 2 hours
TS1  0  3.0
TS1  1  3.0
TS1  2  0.0

[SUBCATCHMENTS]
;;Name  Gage  Outlet  Area  %Imperv  Width  %Slope  CurbLen
S1      G1    O1      10    100        500    1       0

[SUBAREAS]
;;Subcatch  N-Imperv  N-Perv  S-Imperv  S-Perv  PctZero  RouteTo
S1          0.01      0.1     0         0       0        OUTLET

[INFILTRATION]
;; constant infiltration capacity of 1 in/hr (MaxRate = MinRate)
;;Subcatch  MaxRate  MinRate  Decay  DryTime  MaxInfil
S1          1.0      1.0      0      7        0

[LID_CONTROLS]
;; 12 in deep swale, no vegetation volume, n 0.24, 0.5 % slope, 5:1 sides
VS1  VS
VS1  SURFACE  12  0  0.24  0.5  5

[LID_USAGE]
;; 20000 ft2 swale, 20 ft top width, takes all the impervious runoff
;;Subcat  LID  Number  Area   Width  InitSat  FromImp  ToPerv  RptFile
S1        VS1  1       20000  20     0        100      0       CON-20_lid100.txt

[OUTFALLS]
O1  0  FREE

[REPORT]
SUBCATCHMENTS ALL
