[TITLE]
CON-23: rule on a rain gage in a model without subcatchments
;; Gage G2 records 0.5 in/hr from 01:00 to 01:15 and is used only by rule GR,
;; which throttles OR1 to 0.2 while it rains. Expected: OR1 = 0.2 from 01:00
;; to 01:15, 1.0 otherwise.

[OPTIONS]
FLOW_UNITS           CFS
FLOW_ROUTING         DYNWAVE
START_DATE           01/01/2020
START_TIME           00:00:00
REPORT_START_DATE    01/01/2020
REPORT_START_TIME    00:00:00
END_DATE             01/01/2020
END_TIME             03:00:00
ROUTING_STEP         30
RULE_STEP            0
REPORT_STEP          00:05:00
VARIABLE_STEP        0

[JUNCTIONS]
;;Name Elev MaxDepth InitDepth SurDepth Aponded
J1     100  10       2         0        0
J2     99   10       0         0        0

[OUTFALLS]
O1     97   FREE     NO

[ORIFICES]
OR1    J1   J2  SIDE  0  0.65  NO  0

[CONDUITS]
C1     J2   O1  400   0.013  0  0  0  0

[XSECTIONS]
OR1    RECT_CLOSED  1.0  1.0  0  0
C1     CIRCULAR     1.5  0    0  0  1

[INFLOWS]
J1     FLOW  ""  FLOW  1.0  1.0  2.0

[CONTROLS]
RULE GR
IF GAGE G2 INTENSITY > 0.1
THEN ORIFICE OR1 SETTING = 0.2
ELSE ORIFICE OR1 SETTING = 1.0

[RAINGAGES]
;;Name Format    Interval SCF Source
G2     INTENSITY 0:15     1.0 TIMESERIES TSR

[TIMESERIES]
TSR    0:00  0
TSR    1:00  0.5
TSR    1:15  0

[REPORT]
INPUT NO
CONTROLS YES
