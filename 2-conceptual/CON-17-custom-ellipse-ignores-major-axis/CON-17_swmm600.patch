CON-17: scale the full area and radius of custom ellipses with both axes

XSection.cpp setParams() carries the legacy formulas for custom HORIZ_ELLIPSE
and VERT_ELLIPSE pipes (aFull and rFull from the minor axis only). Use
aFull = 0.8117*yFull*wMax and rFull = 0.2448*sqrt(yFull*wMax), as the 5.3.0
patch does (from 0c0a5ca3 / 8e27af6c on origin/dev-elliptical_pipes).

Apply from the root of a Stormwater-Management-Model checkout at cb3e192b:
    git apply CON-17_swmm600.patch

diff --git a/src/engine/hydraulics/XSection.cpp b/src/engine/hydraulics/XSection.cpp
index a01fe26..0475126 100644
--- a/src/engine/hydraulics/XSection.cpp
+++ b/src/engine/hydraulics/XSection.cpp
@@ -486,8 +486,8 @@ int setParams(XSectParams& xs, int type, const double p[], double ucf) {
                 if (p[1] < 0.0) return -1;
                 xs.y_full = p[0] / ucf;
                 xs.w_max  = p[1] / ucf;
-                xs.a_full = 1.2692 * xs.y_full * xs.y_full;
-                xs.r_full = 0.3061 * xs.y_full;
+                xs.a_full = 0.8117 * xs.y_full * xs.w_max;
+                xs.r_full = 0.2448 * std::sqrt(xs.y_full * xs.w_max);
             }
             xs.s_full = xs.a_full * std::pow(xs.r_full, 2.0 / 3.0);
             xs.s_max  = xs.s_full;
@@ -508,8 +508,8 @@ int setParams(XSectParams& xs, int type, const double p[], double ucf) {
                 if (p[1] < 0.0) return -1;
                 xs.y_full = p[0] / ucf;
                 xs.w_max  = p[1] / ucf;
-                xs.a_full = 1.2692 * xs.w_max * xs.w_max;
-                xs.r_full = 0.3061 * xs.w_max;
+                xs.a_full = 0.8117 * xs.y_full * xs.w_max;
+                xs.r_full = 0.2448 * std::sqrt(xs.y_full * xs.w_max);
             }
             xs.s_full = xs.a_full * std::pow(xs.r_full, 2.0 / 3.0);
             xs.s_max  = xs.s_full;
