--- a/src/engine/core/SWMMEngine.cpp
+++ b/src/engine/core/SWMMEngine.cpp
@@ -5730,13 +5730,16 @@ void SWMMEngine::updateRoutingMassBalance(double dt_routing) noexcept {
                 total[up] += quality_outflow * ctx_.nodes.conc[uj * np + up] * dt_routing;
             }
         }
-        // Negative lateral flow withdraws the current mixed concentration.
-        // Its water has already been booked by the inflow assembly.
-        if (ctx_.nodes.lat_flow[uj] < 0.0) {
+        // Negative lateral components withdraw the current mixed
+        // concentration, also when other lateral inflows keep the net flow
+        // positive (CON-10). Their water has already been booked by the
+        // inflow assembly.
+        const double v_withdrawn = quality_.lateralWithdrawal(j);
+        if (v_withdrawn > 0.0) {
             for (int p = 0; p < np; ++p) {
                 const auto up = static_cast<std::size_t>(p);
                 ctx_.mass_balance.qual_routing_outflow[up] +=
-                    -ctx_.nodes.lat_flow[uj] * ctx_.nodes.conc[uj * np + up] * dt_routing;
+                    v_withdrawn * ctx_.nodes.conc[uj * np + up];
             }
         }
 
