[TITLE]
CON-10: J0 (10 cfs DWF at 100 mg/L TSS) drains through C0 to J1, which
has its own 1 cfs DWF at 100 mg/L and, from 1:00 on, a -5 cfs external
inflow (a withdrawal); the net lateral flow at J1 is then -4 cfs. KINWAVE.

[OPTIONS]
FLOW_UNITS           CFS
FLOW_ROUTING         KINWAVE
START_DATE           01/01/2020
START_TIME           00:00:00
REPORT_START_DATE    01/01/2020
REPORT_START_TIME    00:00:00
END_DATE             01/01/2020
END_TIME             04:00:00
REPORT_STEP          00:15:00
WET_STEP             00:05:00
DRY_STEP             01:00:00
ROUTING_STEP         10

[POLLUTANTS]
;;Name  Units  Crain  Cgw  Crdii  Kdecay
TSS     MG/L   0      0    0      0

[JUNCTIONS]
;;Name  Elev  MaxDepth  InitDepth  SurDepth  Aponded
J0      112   5         0          0         0
J1      110   5         0          0         0

[OUTFALLS]
;;Name  Elev  Type
O1      100   FREE

[CONDUITS]
;;Name  From  To  Length  Roughness  InOffset  OutOffset  InitFlow
C0      J0    J1  400     0.013      0         0          0
C1      J1    O1  400     0.013      0         0          0

[XSECTIONS]
;;Link  Shape     Geom1  Geom2  Geom3  Geom4  Barrels
C0      CIRCULAR  2      0      0      0      1
C1      CIRCULAR  2      0      0      0      1

[DWF]
;;Node  Constituent  Baseline
J0      FLOW         10
J0      TSS          100
J1      FLOW         1
J1      TSS          100

[INFLOWS]
;;Node  Constituent  Series  Type  Mfactor  Sfactor  Baseline
J1      FLOW         WD      FLOW  1.0      1.0      0

[TIMESERIES]
;;Name  Time  Value
WD      0:00  0
WD      0:59  0
WD      1:00  -5
WD      4:00  -5

[REPORT]
NODES ALL
LINKS ALL
