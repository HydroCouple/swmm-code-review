[TITLE]
CON-19: vegetative swale with VegFrac = 0.5, run ends while it holds water

[OPTIONS]
FLOW_UNITS       CFS
INFILTRATION     HORTON
FLOW_ROUTING     KINWAVE
START_DATE       01/01/2020
START_TIME       00:00:00
END_DATE         01/01/2020
END_TIME         01:00:00
REPORT_STEP      00:15:00
WET_STEP         00:01:00
DRY_STEP         00:01:00
ROUTING_STEP     60

[EVAPORATION]
CONSTANT 0.0

[RAINGAGES]
;;Name  Format     Interval  SCF  Source
G1      INTENSITY  1:00      1.0  TIMESERIES  TS1

[TIMESERIES]
;; 2 in/hr for 1 hour: 2.0 in of rain
TS1  0  2.0
TS1  1  0.0

[SUBCATCHMENTS]
;;Name  Gage  Outlet  Area  %Imperv  Width  %Slope  CurbLen
S1      G1    O1      1     0        100    1       0

[SUBAREAS]
;;Subcatch  N-Imperv  N-Perv  S-Imperv  S-Perv  PctZero  RouteTo
S1          0.01      0.1     0         0       0        OUTLET

[INFILTRATION]
S1  0  0  4  7  0

[LID_CONTROLS]
;; 12 in deep swale, half of its volume taken up by vegetation,
;; Manning n 0.24, 0.5 % slope, 5:1 side slopes
VS1  VS
VS1  SURFACE  12  0.5  0.24  0.5  5

[LID_USAGE]
;; the swale is the whole subcatchment: 43560 ft2 with a 20 ft top width
;;Subcat  LID  Number  Area   Width  InitSat  FromImp  ToPerv  RptFile
S1        VS1  1       43560  20     0        0        0       CON-19_lid.txt

[OUTFALLS]
O1  0  FREE

[REPORT]
SUBCATCHMENTS ALL
