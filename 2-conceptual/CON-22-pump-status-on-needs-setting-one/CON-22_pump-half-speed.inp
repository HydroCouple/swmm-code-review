[TITLE]
CON-22: premise PUMP P1 STATUS = ON while P1 runs at speed setting 0.5
;; P1 is ON from the start. Rule R1 sets it to half speed at 0:30, rule R3
;; switches it OFF at 1:30. Rule RON is an interlock that keeps orifice ORON
;; open while P1 is ON. Expected: ORON open until 1:30, closed after.

[OPTIONS]
FLOW_UNITS           CFS
FLOW_ROUTING         DYNWAVE
START_DATE           01/01/2020
START_TIME           00:00:00
REPORT_START_DATE    01/01/2020
REPORT_START_TIME    00:00:00
END_DATE             01/01/2020
END_TIME             02:00:00
ROUTING_STEP         30
RULE_STEP            0
REPORT_STEP          00:05:00
VARIABLE_STEP        0

[JUNCTIONS]
;;Name Elev MaxDepth InitDepth SurDepth Aponded
J1     100  10       2         0        0
J2     99   10       0         0        0
J3     99   10       0         0        0

[OUTFALLS]
O1     97   FREE     NO
O2     97   FREE     NO

[PUMPS]
;;Name From To Curve Status Startup Shutoff
P1     J1   J2  *     ON     0       0

[ORIFICES]
ORON   J3   O2  SIDE  0  0.65  NO  0

[CONDUITS]
C1     J2   O1  400   0.013  0  0  0  0

[XSECTIONS]
ORON   RECT_CLOSED  1.0  1.0  0  0
C1     CIRCULAR     1.5  0    0  0  1

[INFLOWS]
J1     FLOW  ""  FLOW  1.0  1.0  2.0

[CONTROLS]
RULE R1
IF SIMULATION TIME > 0.5
THEN PUMP P1 SETTING = 0.5

RULE R3
IF SIMULATION TIME > 1.5
THEN PUMP P1 STATUS = OFF
PRIORITY 5

RULE RON
IF PUMP P1 STATUS = ON
THEN ORIFICE ORON SETTING = 1
ELSE ORIFICE ORON SETTING = 0

[REPORT]
INPUT NO
CONTROLS YES
