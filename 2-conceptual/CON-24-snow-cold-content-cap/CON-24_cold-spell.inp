[TITLE]
CON-24: 4 in snow pack, 72 h at 2 degF, then 6 h at 50 degF

;; One fully pervious 1 ac subcatchment carries a 4 in (water equivalent) pack
;; with Tbase = 32 degF and a constant melt coefficient of 0.01 in/hr/degF.
;; The air stays at 2 degF for 72 h, so the pack builds cold content and its
;; antecedent temperature index (ATI) falls to 2.007 degF. The air then jumps
;; to 50 degF for 6 h: the degree-day melt potential is 0.01 x 18 x 6 = 1.08 in,
;; of which the cold content must be paid back first (RNM = 1).
;; Reference Manual Vol. I, Sec. 6.6 step 8: COLDC <= 0.007 WSNOW (Tbase - ATI)
;;   = 0.007 x 4 x 29.993 = 0.840 in  ->  melt 0.240 in, 3.760 in left.
;; No rain, no infiltration, no evaporation, no free water holding (FWF = 0).

[OPTIONS]
FLOW_UNITS       CFS
INFILTRATION     HORTON
FLOW_ROUTING     KINWAVE
START_DATE       01/01/2020
START_TIME       00:00:00
END_DATE         01/04/2020
END_TIME         06:01:00
REPORT_STEP      01:00:00
WET_STEP         00:01:00
DRY_STEP         00:01:00
ROUTING_STEP     60

[EVAPORATION]
CONSTANT 0.0

[TEMPERATURE]
TIMESERIES TEMP1
;;        Stemp  ATIwt RNM Elev Lat DTLong
SNOWMELT  34     0.5   1.0 0    40  0

[RAINGAGES]
G1 INTENSITY 1:00 1.0 TIMESERIES RAIN1

[TIMESERIES]
RAIN1 01/01/2020 00:00 0.0
TEMP1 01/01/2020 00:00 2
TEMP1 01/04/2020 00:00 2
TEMP1 01/04/2020 00:01 50
TEMP1 01/05/2020 00:00 50

[SNOWPACKS]
;;Name  Surface     Cmin   Cmax   Tbase FWF SD0  FW0 SNN0/SD100
SP1     PLOWABLE    0.01   0.01   32    0   0    0   0
SP1     IMPERVIOUS  0.01   0.01   32    0   0    0   0
SP1     PERVIOUS    0.01   0.01   32    0   4.0  0   0

[SUBCATCHMENTS]
;;Name Gage Outlet Area %Imperv Width %Slope CurbLen SnowPack
S1     G1   O1     1    0       200   1      0       SP1

[SUBAREAS]
S1 0.01 0.1 0 0 0 OUTLET

[INFILTRATION]
S1 0 0 4 7 0

[OUTFALLS]
O1 0 FREE

[REPORT]
SUBCATCHMENTS ALL
