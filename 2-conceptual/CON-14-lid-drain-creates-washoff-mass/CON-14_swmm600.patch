                              ? ctx_.subcatches.total_lid_area_ft2[ui] : 0.0;
         const bool has_lid = lid_ft2 > 0.0;
-        const double v_lost = has_lid ? std::max(v_out1 - v_out2, 0.0) : 0.0;
-        const double v_infil = std::min(lid_infil_vol[ui], v_lost);
