+        std::vector<double> inflow_before_rpt;
         double max_outfall_flow = 0.0; ///< Peak of the summed outfall inflow, cfs (legacy MaxOutfallFlow)
 
         /// Number of time step histogram bins (matching legacy TIMELEVELS=5).
