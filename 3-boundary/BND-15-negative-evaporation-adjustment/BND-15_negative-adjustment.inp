TS1 1 0.0

[SUBCATCHMENTS]
;Name Gage Outlet Area %Imperv Width Slope CurbLen
S1    G1   O1     10   100     500   1     0

[SUBAREAS]
;Nimp Nperv Simp Sperv %Zero RouteTo
