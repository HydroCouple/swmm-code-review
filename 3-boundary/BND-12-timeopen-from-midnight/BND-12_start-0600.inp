[TITLE]
BND-12: TIMEOPEN / TIMECLOSED premises in a run that starts at 06:00
;; P1 is ON and P2 OFF at the start. Rule TOPEN switches P1 off after it has
;; been on for 4 h (expected 10:00); rule TCLOSED switches P2 on after it has
;; been off for 2 h (expected 08:00). P3 is ON and no rule acts on it.

[OPTIONS]
FLOW_UNITS           CFS
FLOW_ROUTING         DYNWAVE
START_DATE           01/01/2020
START_TIME           06:00:00
REPORT_START_DATE    01/01/2020
REPORT_START_TIME    06:00:00
END_DATE             01/01/2020
END_TIME             12:00:00
ROUTING_STEP         30
RULE_STEP            0
REPORT_STEP          00:15:00
VARIABLE_STEP        0

[JUNCTIONS]
;;Name Elev MaxDepth InitDepth SurDepth Aponded
J1     100  10       2         0        0
J2     99   10       0         0        0
J3     99   10       0         0        0
J4     99   10       0         0        0

[OUTFALLS]
O1     97   FREE     NO
O2     97   FREE     NO
O3     97   FREE     NO

[PUMPS]
;;Name From To Curve Status Startup Shutoff
P1     J1   J2  *     ON     0       0
P2     J3   O2  *     OFF    0       0
P3     J4   O3  *     ON     0       0

[CONDUITS]
C1     J2   O1  400   0.013  0  0  0  0

[XSECTIONS]
C1     CIRCULAR     1.5  0    0  0  1

[INFLOWS]
J1     FLOW  ""  FLOW  1.0  1.0  2.0

[CONTROLS]
RULE TOPEN
IF PUMP P1 TIMEOPEN >= 4
THEN PUMP P1 STATUS = OFF

RULE TCLOSED
IF PUMP P2 TIMECLOSED >= 2
THEN PUMP P2 STATUS = ON

[REPORT]
INPUT NO
CONTROLS YES
