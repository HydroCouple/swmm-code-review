[TITLE]
BND-20: the only [EVENTS] period ends at 02:00, reporting starts at 03:00,
so no routing step is taken inside the reporting period

[OPTIONS]
FLOW_UNITS           CFS
INFILTRATION         HORTON
FLOW_ROUTING         DYNWAVE
START_DATE           01/01/2020
START_TIME           00:00:00
REPORT_START_DATE    01/01/2020
REPORT_START_TIME    03:00:00
END_DATE             01/01/2020
END_TIME             04:00:00
WET_STEP             00:05:00
DRY_STEP             00:05:00
REPORT_STEP          00:15:00
ROUTING_STEP         5
VARIABLE_STEP        0

[EVENTS]
01/01/2020 00:00  01/01/2020 02:00

[RAINGAGES]
;;Name  Format     Interval  SCF  Source
G1      INTENSITY  0:15      1.0  TIMESERIES  R1

[SUBCATCHMENTS]
;;Name  Gage  Outlet  Area  %Imperv  Width  Slope  CurbLen
S1      G1    J1      10    50       500    1      0

[SUBAREAS]
;;Subcat  N-Imperv  N-Perv  S-Imperv  S-Perv  PctZero  RouteTo
S1        0.01      0.1     0.05      0.05    25       OUTLET

[INFILTRATION]
;;Subcat  MaxRate  MinRate  Decay  DryTime  MaxInfil
S1        3.0      0.5      4      7        0

[AQUIFERS]
;;Name  Por  WP    FC    Ksat  Kslope  Tslope  ETu  ETs  Seep  Ebot  Egw  Umc
A1      0.5  0.15  0.30  0.1   12      15      0.35 14   0.002 0    4    0.23

[GROUNDWATER]
;;Subcat  Aquifer  Node  Esurf  A1   B1   A2  B2  A3  Dsw  Egwt
S1        A1       J1    6      0.1  1.0  0   0   0   0    4

[JUNCTIONS]
;;Name  Elev  MaxDepth  InitDepth  SurDepth  Aponded
J1      5     4         0          0         0
J2      2     4         0          0         0

[OUTFALLS]
O1      1     FREE

[STORAGE]
;;Name  Elev  MaxDepth  InitDepth  Shape       Area
SU1     3     5         0.5        FUNCTIONAL  0  0  500

[CONDUITS]
C1  J1   SU1  200  0.013  0  0  0  0
C2  J2   O1   200  0.013  0  0  0  0

[PUMPS]
;;Name  From  To  Curve  Status  Startup  Shutoff
P1      SU1   J2  *      ON      1.0      0.6

[XSECTIONS]
C1  CIRCULAR  1.0  0  0  0  1
C2  CIRCULAR  1.0  0  0  0  1

[TIMESERIES]
R1  0:00  1.0
R1  1:00  0.5
R1  2:00  0

[REPORT]
INPUT     NO
CONTROLS  NO
SUBCATCHMENTS ALL
NODES     ALL
LINKS     ALL
