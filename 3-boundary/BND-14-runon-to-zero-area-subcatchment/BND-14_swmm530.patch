@@ -392,6 +393,11 @@ void subcatch_validate(int subcatchIndex)
     if ( Subcatch[subcatchIndex].outNode >= 0 && Subcatch[subcatchIndex].outSubcatch >= 0 )
         report_writeErrorMsg(ERR_SUBCATCH_OUTLET, Subcatch[subcatchIndex].ID);
 
