+++ b/src/engine/hydrology/Inflow.cpp
@@ -516,8 +516,17 @@ void InflowSolver::computeAll(SimulationContext& ctx, double current_date, doubl
             if (p < 0 || p >= np || ni < 0 || ni >= ctx.n_nodes()) continue;
 
             double w = row_value(ui);
-            if (kind == static_cast<int>(ExtInflowKind::CONCEN))
+            if (kind == static_cast<int>(ExtInflowKind::CONCEN)) {
+                // An outfall holds this concentration, so that any reverse
+                // flow into the network carries it.
+                const auto c = static_cast<std::size_t>(ni) *
+                               static_cast<std::size_t>(np) +
+                               static_cast<std::size_t>(p);
+                if (ctx.nodes.type[static_cast<std::size_t>(ni)] == NodeType::OUTFALL &&
+                    c < ctx.nodes.conc_old.size())
+                    ctx.nodes.conc_old[c] = w;
                 w *= ctx.nodes.ext_inflow[static_cast<std::size_t>(ni)];
+            }
 
