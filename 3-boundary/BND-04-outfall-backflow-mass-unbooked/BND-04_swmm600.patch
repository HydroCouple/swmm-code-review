+++ b/src/engine/core/SWMMEngine.cpp
@@ -5670,6 +5670,10 @@ void SWMMEngine::updateRoutingMassBalance(double dt_routing) noexcept {
                 // this function) for the per-step snapshot only.
                 ctx_.mass_balance.routing_external += -q_sys * dt_routing;
                 ctx_.mass_balance.step_ext_inflow  += -q_sys;
+                // ... and the pollutant mass that reverse flow carries in
+                for (int p = 0; p < np; ++p)
+                    ctx_.mass_balance.qual_routing_ex_in[static_cast<std::size_t>(p)] +=
+                        -q_sys * ctx_.nodes.conc[uj * np + static_cast<std::size_t>(p)] * dt_routing;
             }
             // Legacy node_getSystemOutflow zeroes an outfall's overflow and
