[TITLE]
BND-01: a weir discharging to a FREE outfall whose invert is above the storage invert

[OPTIONS]
FLOW_UNITS           CFS
INFILTRATION         HORTON
FLOW_ROUTING         DYNWAVE
LINK_OFFSETS         DEPTH
START_DATE           01/01/2020
START_TIME           00:00:00
REPORT_START_DATE    01/01/2020
REPORT_START_TIME    00:00:00
END_DATE             01/01/2020
END_TIME             06:00:00
REPORT_STEP          00:15:00
WET_STEP             00:05:00
DRY_STEP             01:00:00
ROUTING_STEP         5
ALLOW_PONDING        NO

;; Storage invert 100 ft. The weir crest is 5 ft above it (elevation 105).
;; The FREE outfall's invert is 103 ft: 2 ft below the crest, so the weir
;; discharges freely. 5.3.0 gives O1 a depth equal to the crest height
;; (5 ft, HGL 108), which is 3 ft above the crest.
[STORAGE]
;;Name Elev MaxDepth InitDepth Shape     Coeff Expon Const SurDepth Fevap
SU1    100  20       0         FUNCTIONAL 0     0     2000  0        0

[OUTFALLS]
;;Name  Elev  Type  Stage Gated
O1      103   FREE        NO

[WEIRS]
;;Name From To  Type        CrestHt Cd   Gated EC Cd2
W1      SU1  O1  TRANSVERSE  5       3.33 NO    0  0

[XSECTIONS]
;;Link  Shape      Height Length
W1      RECT_OPEN  10     20     0  0

[INFLOWS]
;;Node Param TSeries Type Mfactor Sfactor Baseline
SU1    FLOW  ""      FLOW 1.0     1.0     20

[REPORT]
NODES ALL
LINKS ALL
