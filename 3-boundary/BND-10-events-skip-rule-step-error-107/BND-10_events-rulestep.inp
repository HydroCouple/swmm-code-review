[TITLE]
BND-10: RULE_STEP 60 s is not a multiple of ROUTING_STEP 45 s, and routing
is restricted to one event (03:00-05:00) of a 6-hour run

[OPTIONS]
FLOW_UNITS           CFS
FLOW_ROUTING         DYNWAVE
START_DATE           01/01/2020
START_TIME           00:00:00
REPORT_START_DATE    01/01/2020
REPORT_START_TIME    00:00:00
END_DATE             01/01/2020
END_TIME             06:00:00
ROUTING_STEP         45
RULE_STEP            00:01:00
REPORT_STEP          00:15:00
VARIABLE_STEP        0

[JUNCTIONS]
;;Name  Elev  MaxDepth  InitDepth  SurDepth  Aponded
J1      100   10        2          0         0
J2      99    10        0          0         0

[OUTFALLS]
;;Name  Elev  Type
O1      97    FREE

[ORIFICES]
;;Name  From  To  Type  Offset  Qcoeff  Gated  CloseTime
OR1     J1    J2  SIDE  0       0.65    NO    0

[CONDUITS]
;;Name  From  To  Length  Roughness  InOffset  OutOffset  InitFlow
C1      J2    O1  400     0.013      0         0          0

[XSECTIONS]
;;Link  Shape        Geom1  Geom2  Geom3  Geom4  Barrels
OR1     RECT_CLOSED  1.0    1.0    0      0
C1      CIRCULAR     1.5    0      0      0      1

[INFLOWS]
;;Node  Constituent  Series  Type  Mfactor  Sfactor  Baseline
J1      FLOW         ""      FLOW  1.0      1.0      2.0

[CONTROLS]
;; Should act at 01:00, between events
RULE R1
IF SIMULATION TIME > 1
THEN ORIFICE OR1 SETTING = 0.2
ELSE ORIFICE OR1 SETTING = 1.0

[EVENTS]
;;Start date  time   End date    time
01/01/2020    03:00  01/01/2020  05:00

[REPORT]
CONTROLS YES
LINKS ALL
NODES ALL
