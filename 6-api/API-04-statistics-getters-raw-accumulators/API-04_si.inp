[TITLE]
API-04 SI units: S1 drains to J1; extra inflow floods J1 for a while; C1, C2 to outfall O1

[OPTIONS]
FLOW_UNITS           CMS
INFILTRATION         HORTON
FLOW_ROUTING         DYNWAVE
START_DATE           01/01/2020
START_TIME           00:00:00
REPORT_START_DATE    01/01/2020
REPORT_START_TIME    00:00:00
END_DATE             01/01/2020
END_TIME             06:00:00
WET_STEP             00:01:00
DRY_STEP             00:05:00
ROUTING_STEP         0:00:30
REPORT_STEP          00:15:00

[RAINGAGES]
;; 25 mm/hr for 15 min at 1:00 and 12.5 mm/hr for 15 min at 2:00 = 9.375 mm
G1   INTENSITY 0:15 1.0 TIMESERIES TS1

[SUBCATCHMENTS]
;;   gage outlet area(ha) %imperv width(m) %slope
S1   G1   J1   4    50   150   0.5   0

[SUBAREAS]
S1   0.01  0.1  1.25  1.25  25  OUTLET

[INFILTRATION]
S1   75  12.5  4  7  0

[JUNCTIONS]
;;   invert(m)  maxDepth(m)
J1   30.0       1.0       0   0   0
J2   29.7       3.0       0   0   0

[OUTFALLS]
O1   29.1   FREE   NO

[CONDUITS]
C1   J1   J2   120   0.013   0   0   0   0
C2   J2   O1   120   0.013   0   0   0   0

[XSECTIONS]
C1   CIRCULAR   0.45   0   0   0   1
C2   CIRCULAR   0.45   0   0   0   1

[INFLOWS]
J1   FLOW   TSQ   FLOW   1.0   1.0

[TIMESERIES]
TS1   0:00   0
TS1   1:00   25
TS1   2:00   12.5
TS1   3:00   0
;; extra inflow at J1, 0.35 m3/s peak at 1:30
TSQ   0:00   0
TSQ   0:30   0
TSQ   1:30   0.35
TSQ   2:30   0

[REPORT]
INPUT NO
CONTROLS NO
SUBCATCHMENTS ALL
NODES ALL
LINKS ALL
