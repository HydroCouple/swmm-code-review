[TITLE]
API-14: gages G1 and G2 share series TS1, G3 has its own copy TS3

[OPTIONS]
FLOW_UNITS       CFS
INFILTRATION     HORTON
FLOW_ROUTING     KINWAVE
START_DATE       01/01/2020
START_TIME       00:00:00
END_DATE         01/01/2020
END_TIME         03:00:00
REPORT_STEP      00:15:00
WET_STEP         00:05:00
DRY_STEP         00:05:00
ROUTING_STEP     60

[EVAPORATION]
CONSTANT 0.0

[RAINGAGES]
;;Name  Format     Interval  SCF  Source
G1      INTENSITY  1:00      1.0  TIMESERIES  TS1
G2      INTENSITY  1:00      1.0  TIMESERIES  TS1
G3      INTENSITY  1:00      1.0  TIMESERIES  TS3

[TIMESERIES]
;; 0.5 in/hr for three hours; TS3 is the same data under another name
TS1  0:00  0.5
TS1  1:00  0.5
TS1  2:00  0.5
TS1  3:00  0.0
TS3  0:00  0.5
TS3  1:00  0.5
TS3  2:00  0.5
TS3  3:00  0.0

[SUBCATCHMENTS]
;;Name  Gage  Outlet  Area  %Imperv  Width  %Slope  CurbLen
S1      G1    O1      10    100      500    1       0
S2      G2    O1      10    100      500    1       0
S3      G3    O1      10    100      500    1       0

[SUBAREAS]
;;Subcatch  N-Imperv  N-Perv  S-Imperv  S-Perv  PctZero  RouteTo
S1          0.01      0.1     0         0       0        OUTLET
S2          0.01      0.1     0         0       0        OUTLET
S3          0.01      0.1     0         0       0        OUTLET

[INFILTRATION]
;;Subcatch  MaxRate  MinRate  Decay  DryTime  MaxInfil
S1          0        0        4      7        0
S2          0        0        4      7        0
S3          0        0        4      7        0

[OUTFALLS]
;;Name  Elev  Type
O1      0     FREE

[REPORT]
SUBCATCHMENTS ALL
