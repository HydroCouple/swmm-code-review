[TITLE]
API-09 as API-09_base.inp with slope 5 %

[OPTIONS]
FLOW_UNITS           CFS
INFILTRATION         HORTON
FLOW_ROUTING         KINWAVE
START_DATE           01/01/2020
START_TIME           00:00:00
REPORT_START_DATE    01/01/2020
REPORT_START_TIME    00:00:00
END_DATE             01/01/2020
END_TIME             03:00:00
WET_STEP             00:01:00
DRY_STEP             00:01:00
ROUTING_STEP         0:00:30
REPORT_STEP          00:15:00

[RAINGAGES]
;;   format    interval  SCF  source
G1   INTENSITY 0:10      1.0  TIMESERIES TS1

[SUBCATCHMENTS]
;;   gage outlet  area  %imperv  width  %slope  curbLen
S1   G1   O1      10    100      500    5       0

[SUBAREAS]
;;   N-imperv N-perv S-imperv S-perv %Zero RouteTo
S1   0.015    0.1    0       0      100   OUTLET

[INFILTRATION]
S1   3.0  0.5  4  7  0

[OUTFALLS]
O1   0   FREE   NO

[TIMESERIES]
;; 2 in/hr for 10 minutes
TS1   0:00   2.0
TS1   0:10   0.0

[REPORT]
INPUT NO
CONTROLS NO
