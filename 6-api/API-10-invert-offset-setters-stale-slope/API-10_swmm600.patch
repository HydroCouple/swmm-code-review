+/**
+ * @brief Recompute a conduit's slope from its end-node inverts and offsets,
+ *        then its flow properties (@ref recompute_conduit_flow_properties).
+ *
+ * @details Used by the invert and offset setters after @c open(), so the
+ *          edit changes the slope, beta and full flow as the same edit in
+ *          the input file would.
+ *
+ * @param ctx  Simulation context (mutated in place).
+ * @param j    Link index (non-conduits are left untouched).
+ */
+void recompute_conduit_slope(SimulationContext& ctx, int j);
+
 /**
