[TITLE]
API-17: one node of each type (JUNCTION 0, OUTFALL 1, STORAGE 2, DIVIDER 3) and one link of each type (CONDUIT 0, PUMP 1, ORIFICE 2, WEIR 3, OUTLET 4)

[OPTIONS]
FLOW_UNITS           CFS
INFILTRATION         HORTON
FLOW_ROUTING         DYNWAVE
START_DATE           01/01/2020
START_TIME           00:00:00
REPORT_START_DATE    01/01/2020
REPORT_START_TIME    00:00:00
END_DATE             01/01/2020
END_TIME             06:00:00
WET_STEP             00:05:00
DRY_STEP             00:15:00
ROUTING_STEP         0:00:05
REPORT_STEP          00:15:00

[RAINGAGES]
;;Name  Format     Interval SCF Source
RG1     INTENSITY  1:00     1.0 TIMESERIES TS1

[SUBCATCHMENTS]
;;Name  Gage  Outlet  Area  %Imperv  Width  %Slope  CurbLen
S1      RG1   J1      10    50       500    0.5     0

[SUBAREAS]
;;Subcat  N-Imperv  N-Perv  S-Imperv  S-Perv  PctZero  RouteTo
S1        0.01      0.1     0.05      0.05    25       OUTLET

[INFILTRATION]
;;Subcat  MaxRate  MinRate  Decay  DryTime  MaxInfil
S1        3.0      0.5      4      7        0

[JUNCTIONS]
;;Name  Elev  MaxDepth
J1      12    5
J2      1     5

[OUTFALLS]
;;Name  Elev  Type
O1      0     FREE

[DIVIDERS]
;;Name  Elev  DivLink  Type    CutoffFlow  MaxDepth
D1      10    OR1      CUTOFF  0.5         5

[STORAGE]
;;Name  Elev  MaxDepth  InitDepth  Shape       Coeff  Expon  Const
SU1     4     8         0          FUNCTIONAL  0      0      1000

[CONDUITS]
;;Name  From  To   Length  Roughness  InOffset  OutOffset
C1      J1    D1   400     0.013      0         0
C2      D1    SU1  400     0.013      0         0
C3      J2    O1   400     0.013      0         0

[PUMPS]
;;Name  From  To  Curve  Status  Startup  Shutoff
P1      SU1   J2  PC1    ON      3        1

[ORIFICES]
;;Name  From  To  Type    Offset  Qcoeff
OR1     D1    J2  BOTTOM  0       0.65

[WEIRS]
;;Name  From  To  Type        CrestHt  Qcoeff
W1      SU1   J2  TRANSVERSE  5        3.33

[OUTLETS]
;;Name  From  To  Offset  Type              Qcoeff  Qexpon  Gated
OL1     SU1   J2  1       FUNCTIONAL/DEPTH  0.2     0.5     NO

[XSECTIONS]
;;Link  Shape      Geom1  Geom2  Geom3  Geom4  Barrels
C1      CIRCULAR   1.5    0      0      0      1
C2      CIRCULAR   1.5    0      0      0      1
C3      CIRCULAR   2      0      0      0      1
OR1     CIRCULAR   0.5    0      0      0
W1      RECT_OPEN  1      4      0      0

[CURVES]
;;Name  Type   X     Y
PC1     PUMP3  0     2
PC1            20    0

[TIMESERIES]
;; the series runs past the end of the simulation so the gage always has a next rain date
TS1  01/01/2020  00:00  1.0
TS1  01/01/2020  01:00  0.0
TS1  01/01/2020  07:00  0.0

[REPORT]
SUBCATCHMENTS ALL
NODES ALL
LINKS ALL
