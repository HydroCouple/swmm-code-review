                 offset += (1 + p_data->NodeProperties + elementIndex * p_data->NodeProperties + propertyIndex) * RECORDSIZE;
                 _fseek(p_data->file, offset, SEEK_SET);
-                fread(value, RECORDSIZE, 1, p_data->file);
