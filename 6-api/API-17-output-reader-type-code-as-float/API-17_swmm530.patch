+/*!
+ * \def TYPE_CODE_PROPERTY
+ * \brief Property code of a node's or link's type, which the output file
+ *        stores as an INT4 (INPUT_TYPE_CODE in the engine's output.c)
+ */
+#define TYPE_CODE_PROPERTY 0
+
 /*!
  * \struct IDentry
  * \brief Structure for element names
@@ -1170,6 +1177,24 @@ int EXPORT_OPENSWMMCORE_OUTPUT_API SMO_getSubcatchSeries(
     return set_error(p_data->error_handle, errorcode);
 }
 
+/*!
+ * \brief Reads the property value at the current file position; the
+ *        type code is an INT4, all other properties are REAL4
+ */
+static float readPropertyValue(FILE *file, int propertyCode)
+{
+    INT4 k = 0;
+    REAL4 x = 0.0f;
+
+    if (propertyCode == TYPE_CODE_PROPERTY)
+    {
+        fread(&k, RECORDSIZE, 1, file);
+        return (REAL4)k;
+    }
+    fread(&x, RECORDSIZE, 1, file);
+    return x;
+}
