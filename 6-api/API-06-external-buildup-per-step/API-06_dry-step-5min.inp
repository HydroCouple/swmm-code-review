[TITLE]
API-06: one dry day on a 10 ac subcatchment with one land use (100%) and a
pollutant with no buildup function of its own. DRY_STEP 00:05:00.

[OPTIONS]
FLOW_UNITS           CFS
INFILTRATION         HORTON
FLOW_ROUTING         KINWAVE
START_DATE           01/01/2020
START_TIME           00:00:00
REPORT_START_DATE    01/01/2020
REPORT_START_TIME    00:00:00
END_DATE             01/02/2020
END_TIME             00:00:00
DRY_DAYS             0
DRY_STEP             00:05:00
WET_STEP             00:05:00
ROUTING_STEP         60
REPORT_STEP          01:00:00

[EVAPORATION]
CONSTANT  0.0

[RAINGAGES]
;;Name Format    Interval SCF Source
G1     INTENSITY 1:00     1.0 TIMESERIES TS1

[SUBCATCHMENTS]
;;Name Gage Outlet Area %Imperv Width %Slope CurbLen
S1     G1   J1     10   50      500   1.0    0

[SUBAREAS]
S1  0.015  0.1  0.05  0.05  25  OUTLET

[INFILTRATION]
S1  3.0  0.5  4  7  0

[JUNCTIONS]
J1  10  5  0  0  0

[OUTFALLS]
O1  5  FREE

[CONDUITS]
C1  J1  O1  400  0.013  0  0  0

[XSECTIONS]
C1  CIRCULAR  1.0  0  0  0  1

[POLLUTANTS]
;;Name Units Crain Cgw Crdii Kdecay SnowOnly CoPollut CoFrac Cdwf Cinit
P1  MG/L  0  0  0  0  NO  *  0  0  0

[LANDUSES]
L1

[COVERAGES]
S1  L1  100

[BUILDUP]
;;LandUse Pollutant Function C1 C2 C3 PerUnit
L1  P1  NONE  0  0  0  AREA

[WASHOFF]
;;LandUse Pollutant Function C1 C2 SweepRmvl BmpRmvl
L1  P1  EMC  0  0  0  0

[TIMESERIES]
TS1  0:00   0.0
TS1  1:00   0.0
TS1  24:00  0.0
