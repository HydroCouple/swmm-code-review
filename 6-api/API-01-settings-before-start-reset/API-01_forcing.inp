[TITLE]
API-01: forcing values set through the toolkit between swmm_open and swmm_start

[OPTIONS]
FLOW_UNITS           CFS
INFILTRATION         HORTON
FLOW_ROUTING         DYNWAVE
START_DATE           01/01/2020
START_TIME           00:00:00
REPORT_START_DATE    01/01/2020
REPORT_START_TIME    00:00:00
END_DATE             01/01/2020
END_TIME             02:00:00
WET_STEP             00:01:00
DRY_STEP             00:01:00
ROUTING_STEP         0:00:30
REPORT_STEP          00:15:00

;; The gage's own series is dry, so any rain in the run comes from the API.
[RAINGAGES]
G1   INTENSITY 0:15 1.0 TIMESERIES DRY

