[JUNCTIONS]
J1   100   10   0   0   0
J2   99    10   0   0   0

[OUTFALLS]
O1   97   FREE   NO

[CONDUITS]
C1   J1   J2   400   0.013   0   0   0   0

[ORIFICES]
OR1  J2   O1   SIDE  0   0.65   NO   0

[XSECTIONS]
C1   CIRCULAR   1.5   0   0   0   1
OR1  CIRCULAR   1.0   0   0   0

[TIMESERIES]
