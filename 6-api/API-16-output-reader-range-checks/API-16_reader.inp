[TITLE]
API-16: output file for the reader range-check probes (1 subcatchment, 4 nodes, 3 links, no pollutants, 24 periods)

[OPTIONS]
FLOW_UNITS           CFS
INFILTRATION         HORTON
FLOW_ROUTING         KINWAVE
START_DATE           01/01/2020
START_TIME           00:00:00
REPORT_START_DATE    01/01/2020
REPORT_START_TIME    00:00:00
END_DATE             01/01/2020
END_TIME             06:00:00
WET_STEP             00:05:00
DRY_STEP             00:15:00
ROUTING_STEP         0:00:30
REPORT_STEP          00:15:00

[RAINGAGES]
;;Name  Format     Interval SCF Source
RG1     INTENSITY  0:15     1.0 TIMESERIES TS1

[SUBCATCHMENTS]
;;Name  Gage  Outlet  Area  %Imperv  Width  %Slope  CurbLen
S1      RG1   J1      10    50       500    0.5     0

[SUBAREAS]
;;Subcat  N-Imperv  N-Perv  S-Imperv  S-Perv  PctZero  RouteTo
S1        0.01      0.1     0.05      0.05    25       OUTLET

[INFILTRATION]
;;Subcat  MaxRate  MinRate  Decay  DryTime  MaxInfil
S1        3.0      0.5      4      7        0

[JUNCTIONS]
;;Name  Elev  MaxDepth
J1      10    5
J2      8     5
J3      6     5

[OUTFALLS]
;;Name  Elev  Type
O1      4     FREE

[CONDUITS]
;;Name  From  To  Length  Roughness  InOffset  OutOffset
C1      J1    J2  400     0.013      0         0
C2      J2    J3  400     0.013      0         0
C3      J3    O1  400     0.013      0         0

[XSECTIONS]
;;Link  Shape     Geom1  Geom2 Geom3 Geom4 Barrels
C1      CIRCULAR  1.5       0     0     0     1
C2      CIRCULAR  1.5       0     0     0     1
C3      CIRCULAR  1.5       0     0     0     1

[TIMESERIES]
;; the series runs past the end of the simulation so the gage always has a next rain date
TS1  01/01/2020  00:00  1.0
TS1  01/01/2020  01:00  0.0
TS1  01/01/2020  07:00  0.0

[REPORT]
SUBCATCHMENTS ALL
NODES ALL
LINKS ALL
