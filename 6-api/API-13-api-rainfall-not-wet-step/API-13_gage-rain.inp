[TITLE]
API-13 reference: the same 2 in/hr for 30 min from the rain gage

[OPTIONS]
FLOW_UNITS           CFS
INFILTRATION         HORTON
FLOW_ROUTING         KINWAVE
START_DATE           06/01/2020
START_TIME           00:00:00
REPORT_START_DATE    06/01/2020
REPORT_START_TIME    00:00:00
END_DATE             06/01/2020
END_TIME             03:00:00
WET_STEP             00:01:00
DRY_STEP             01:00:00
REPORT_STEP          00:15:00
ROUTING_STEP         0:01:00

[EVAPORATION]
CONSTANT         0.0

[RAINGAGES]
;;   format    interval  SCF  source
G1   INTENSITY 0:30      1.0  TIMESERIES R1

[SUBCATCHMENTS]
;;   gage outlet  area  %imperv  width  %slope  curbLen
S1   G1   O1      1.0   100      200    1.0     0

[SUBAREAS]
;;   N-imperv N-perv S-imperv S-perv %Zero RouteTo
S1   0.01     0.1    0.05     0.05   25    OUTLET

[INFILTRATION]
S1   0.0   0.0   4   7   0

[OUTFALLS]
O1   0   FREE

[TIMESERIES]
;; 2 in/hr for 30 min
R1   0:00   2.0
R1   0:30   0.0
