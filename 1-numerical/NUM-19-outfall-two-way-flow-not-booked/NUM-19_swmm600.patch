@@ -5610,6 +5611,11 @@ void SWMMEngine::updateRoutingMassBalance(double dt_routing) noexcept {
             // SKIP_STEADY_STATE step inherits from rule 2's inflow write —
             // as outflow: weir-overtopping's Spill added its 1186 cfs
             // reverse flow to OUTFALL_FLOWS on every skipped step.
+            // A skipped step keeps the inflow written below on the last
+            // routed step; the outfall itself receives nothing.
+            if (last_step_steady_ && outfall_inflow_is_backflow_[uj])
+                ctx_.nodes.inflow[uj] = 0.0;
+            outfall_inflow_is_backflow_[uj] = 0;
             const double q_in  = ctx_.nodes.inflow[uj];
             const double q_out = ctx_.nodes.outflow[uj];
 
@@ -5654,11 +5660,15 @@ void SWMMEngine::updateRoutingMassBalance(double dt_routing) noexcept {
                 }
             } else if (q_out == 0.0) {
                 q_sys = q_in;
-            } else if (q_in == 0.0) {
-                q_sys = -q_out;
-                // Legacy node_getSystemOutflow (node.c:441-444): a backflowing
