+                    // outfall reports its discharge magnitude as node inflow.
+                    ctx_.nodes.inflow[uj] = std::fabs(q_sys);
+                    outfall_inflow_is_backflow_[uj] = 1;
+                }
             }
             if (q_sys > 0.0) {
                 quality_outflow = q_sys;
