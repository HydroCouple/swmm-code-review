diff --git a/src/legacy/engine/datetime.c b/src/legacy/engine/datetime.c
index 31eb5bc..91617e8 100644
--- a/src/legacy/engine/datetime.c
+++ b/src/legacy/engine/datetime.c
@@ -466,6 +466,25 @@ int  datetime_dayOfYear(DateTime date)
 
 //=============================================================================
 
+double datetime_dayOfYear365(DateTime date)
+
+//  Input:   date = an encoded date/time value
+//  Output:  returns day of year in a 365-day calendar (1..365)
+//  Purpose: finds the day of year a date's month and day have in a non-leap
+//           year (the calendar month/day inputs are converted with), so that
+//           03/01 is 60 and 12/31 is 365 in every year; Feb 29 is 59.5.
+
+{
+    int year, month, day;
+    double doy = datetime_dayOfYear(date);
+    datetime_decodeDate(date, &year, &month, &day);
+    if ( isLeapYear(year) && month > 2 ) doy -= 1.0;
+    else if ( month == 2 && day == 29 ) doy -= 0.5;
+    return doy;
+}
+
