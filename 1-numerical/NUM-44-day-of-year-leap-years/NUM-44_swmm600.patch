diff --git a/src/engine/core/DateTime.hpp b/src/engine/core/DateTime.hpp
index 27b5c23..39f26dc 100644
--- a/src/engine/core/DateTime.hpp
+++ b/src/engine/core/DateTime.hpp
@@ -219,6 +219,20 @@ inline int dayOfYear(DateTime date) {
     return static_cast<int>(std::floor(date - startOfYear)) + 1;
 }
 
+/**
+ * @brief Day of year of a date's month and day in a 365-day (non-leap)
+ *        calendar, the one month/day inputs are converted with: 03/01 is 60
+ *        and 12/31 is 365 in every year; Feb 29 falls between them (59.5).
+ */
+inline double dayOfYear365(DateTime date) {
+    int y, m, d;
+    decodeDate(date, y, m, d);
+    double doy = dayOfYear(date);
+    if (isLeapYear(y) && m > 2) doy -= 1.0;
+    else if (m == 2 && d == 29) doy -= 0.5;
+    return doy;
+}
+
 } // namespace datetime
 } // namespace openswmm
 
