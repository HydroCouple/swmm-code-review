[TITLE]
NUM-38: permeable pavement, soil layer slower than the underdrain

[OPTIONS]
FLOW_UNITS       CFS
INFILTRATION     HORTON
FLOW_ROUTING     KINWAVE
START_DATE       01/01/2020
START_TIME       00:00:00
END_DATE         01/01/2020
END_TIME         12:00:00
REPORT_STEP      00:15:00
WET_STEP         00:01:00
DRY_STEP         00:01:00
ROUTING_STEP     60

[EVAPORATION]
CONSTANT 0.0

[RAINGAGES]
;;Name  Format     Interval  SCF  Source
G1      INTENSITY  1:00      1.0  TIMESERIES  TS1

[TIMESERIES]
;; 3 in/hr for 3 hours: 9.0 in of rain
TS1  0  3.0
TS1  1  3.0
TS1  2  3.0
TS1  3  0.0

[SUBCATCHMENTS]
;;Name  Gage  Outlet  Area  %Imperv  Width  %Slope  CurbLen
S1      G1    O1      1     0        100    1       0

[SUBAREAS]
;;Subcatch  N-Imperv  N-Perv  S-Imperv  S-Perv  PctZero  RouteTo
S1          0.01      0.1     0         0       0        OUTLET

[INFILTRATION]
S1  0  0  4  7  0

[LID_CONTROLS]
;; 2 in of pavement (100 in/hr) over 2 in of soil (Ksat 0.5 in/hr) over a
;; 12 in gravel bed with an impermeable floor and an underdrain at its
;; bottom (C = 50, n = 0.5). The soil limits the flow to the drain.
PP1  PP
PP1  SURFACE   0.0  0     0    0     0
PP1  PAVEMENT  2    0.15  0    100   0
PP1  SOIL      2    0.5   0.2  0.1   0.5  10  3.5
PP1  STORAGE   12   0.75  0    0
PP1  DRAIN     50   0.5   0    0

[LID_USAGE]
;;Subcat  LID  Number  Area   Width  InitSat  FromImp  ToPerv  RptFile
S1        PP1  1       43560  0      0        0        0       NUM-38_lid.txt

[OUTFALLS]
O1  0  FREE

[REPORT]
SUBCATCHMENTS ALL
