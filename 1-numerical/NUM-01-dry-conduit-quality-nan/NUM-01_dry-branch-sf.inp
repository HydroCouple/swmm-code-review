[TITLE]
NUM-01: STEADY, one pollutant; every conduit is dry for the first 2 hours
and conduit C3 never carries water. Rain falls from 2:00 to 3:00 at 10 mg/L.

[OPTIONS]
FLOW_UNITS           CFS
INFILTRATION         HORTON
FLOW_ROUTING         STEADY
START_DATE           01/01/2020
START_TIME           00:00:00
REPORT_START_DATE    01/01/2020
REPORT_START_TIME    00:00:00
END_DATE             01/01/2020
END_TIME             06:00:00
DRY_DAYS             0
WET_STEP             00:01:00
DRY_STEP             00:05:00
ROUTING_STEP         00:00:30
REPORT_STEP          00:15:00

[RAINGAGES]
;;Name  Format     Interval  SCF  Source
RG1     INTENSITY  0:15      1.0  TIMESERIES  Rain

[SUBCATCHMENTS]
;;Name  RainGage  Outlet  Area  %Imperv  Width  %Slope  CurbLen
S1      RG1       J1      5     100      500    1       0

[SUBAREAS]
;;Subcatch  N-Imperv  N-Perv  S-Imperv  S-Perv  PctZero  RouteTo
S1          0.01      0.1     0         0.05    100      OUTLET

[INFILTRATION]
S1          3.0       0.5     4       7       0

[JUNCTIONS]
;;Name  Elev  MaxDepth
J1      100   5
J2      98    5
J3      101   5

[OUTFALLS]
;;Name  Elev  Type
O1      96    FREE

[CONDUITS]
;;Name  From  To   Length  N      InOffset  OutOffset
C1      J1    J2   400     0.013  0         0
C2      J2    O1   400     0.013  0         0
C3      J3    J2   400     0.013  0         0

[XSECTIONS]
;;Link  Shape     Geom1  Geom2  Geom3  Geom4  Barrels
C1      CIRCULAR  1.5    0      0      0      1
C2      CIRCULAR  1.5    0      0      0      1
C3      CIRCULAR  1.5    0      0      0      1

[POLLUTANTS]
;;Name  Units  Crain  Cgw  Crdii  Kdecay
TSS     MG/L   10     0    0      0

[TIMESERIES]
Rain    0:00   0.0
Rain    2:00   1.0
Rain    3:00   0.0
Rain    6:00   0.0

[REPORT]
INPUT      NO
CONTROLS   NO
SUBCATCHMENTS ALL
NODES ALL
LINKS ALL
