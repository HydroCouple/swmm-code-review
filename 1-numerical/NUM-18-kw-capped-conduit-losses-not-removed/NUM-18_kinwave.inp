[TITLE]
NUM-18: a conduit with seepage losses receives more than its full flow (KINWAVE)

[OPTIONS]
FLOW_UNITS           CFS
FLOW_ROUTING         KINWAVE
START_DATE           01/01/2020
START_TIME           00:00:00
REPORT_START_DATE    01/01/2020
REPORT_START_TIME    00:00:00
END_DATE             01/01/2020
END_TIME             06:00:00
REPORT_STEP          00:15:00
WET_STEP             00:05:00
DRY_STEP             01:00:00
ROUTING_STEP         60

;; J1 receives 40 cfs; C1 (2 ft, 2000 ft at 0.5 %) carries about 16 cfs when
;; full, so C1 runs full and J1 floods the rest.
[JUNCTIONS]
;;Name  Elev  MaxDepth InitDepth SurDepth Aponded
J1      110   5         0        0        0

[OUTFALLS]
;;Name  Elev  Type  Stage Gated
O1      100   FREE        NO

[CONDUITS]
;;Name From To Length Rough InOff OutOff InitFlow
C1      J1   O1  2000  0.013 0     0      0

[XSECTIONS]
C1      CIRCULAR 2 0 0 0 1

;; Seepage of 50 in/hr through the 2-ft wide pipe: about 4.6 cfs.
[LOSSES]
;;Link Kentry Kexit Kavg Flap Seepage
C1     0      0     0    NO   50

[INFLOWS]
;;Node Param TSeries Type Mfactor Sfactor Baseline
J1     FLOW  ""      FLOW 1.0     1.0     40

[REPORT]
LINKS ALL
