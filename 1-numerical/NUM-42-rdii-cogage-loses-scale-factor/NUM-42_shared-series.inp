[TITLE]
NUM-42: UH on gage G2 (rain scale factor 2.0), which shares series TS1 with G1 (scale 1.0)

[OPTIONS]
FLOW_UNITS       CFS
INFILTRATION     HORTON
FLOW_ROUTING     KINWAVE
START_DATE       01/01/2020
START_TIME       00:00:00
END_DATE         01/01/2020
END_TIME         06:00:00
REPORT_STEP      00:15:00
WET_STEP         00:15:00
DRY_STEP         01:00:00
ROUTING_STEP     60

[RAINGAGES]
;; G1 is declared first and is used by S1, so G2 becomes its co-gage.
;; The last token of G2 is the 5.3.0 rain scale factor (5.2.4 ignores it).
;;Name  Format  Interval  SCF  Source      Series  ScaleFactor
G1      VOLUME  1:00      1.0  TIMESERIES  TS1
G2      VOLUME  1:00      1.0  TIMESERIES  TS1     2.0

[SUBCATCHMENTS]
;;Name  Gage  Outlet  Area  %Imperv  Width  %Slope  CurbLen
S1      G1    O2      1     50       100    1       0

[SUBAREAS]
S1  0.01  0.1  0  0  0  OUTLET

[INFILTRATION]
S1  0  0  4  7  0

[TIMESERIES]
;; 1.0 in in the first hour
TS1  01/01/2020  00:00  1.0
TS1  01/01/2020  01:00  0.0

[HYDROGRAPHS]
;; R = 0.1, T = 1 h, K = 2 on gage G2
UH1  G2
UH1  ALL  SHORT  0.1  1  2

[RDII]
;;Node  UHgroup  SewerArea(ac)
J1      UH1      100

[JUNCTIONS]
J1  0  10

[OUTFALLS]
O1  -1  FREE
O2  -1  FREE

[CONDUITS]
C1  J1  O1  100  0.01  0  0

[XSECTIONS]
C1  CIRCULAR  2  0  0  0  1
