 //=============================================================================
 
+double getGageRainfall(int g, DateTime date1, DateTime date2)
+//
+//  Input:   g = rain gage index
+//           date1 = start of a time period
+//           date2 = end of the time period
+//  Output:  returns average rainfall intensity (in/hr or mm/hr)
+//  Purpose: finds a rain gage's average rainfall intensity over a time period.
+//
+{
+    long     totalSecs = datetime_timeDiff(date2, date1);
+    long     secs = 0;                 // seconds from date1 to t
+    long     nextSecs;                 // seconds from date1 to tNext
+    long     runSecs = 0;              // length of current constant-rain run
+    double   r = 0.0;                  // rainfall intensity of current run
+    double   sum = 0.0;                // rain volume of previous runs
+    DateTime t = date1, tNext;
+
+    // --- step through the dates at which the gage's rainfall changes,
+    //     merging consecutive periods with the same intensity
+    while ( secs < totalSecs )
+    {
+        gage_setState(g, t);
+        tNext = gage_getNextRainDate(g, t);
+        nextSecs = totalSecs;
+        if ( tNext > t && tNext < date2 )
+            nextSecs = MIN(datetime_timeDiff(tNext, date1), totalSecs);
+        else tNext = date2;
+        if ( runSecs > 0 && Gage[g].rainfall != r )
+        {
+            sum += r * (double)runSecs;
+            runSecs = 0;
+        }
+        r = Gage[g].rainfall;
+        runSecs += nextSecs - secs;
+        secs = nextSecs;
+        t = tNext;
+    }
+    if ( runSecs == totalSecs ) return r;
+    return (sum + r * (double)runSecs) / (double)totalSecs;
+}
