[TITLE]
NUM-53: SIMULATION TIME = and CLOCKTIME = premises with RULE_STEP 5 min
;; Rules are evaluated every 5 min (00:00, 00:05, ...). TEQ asks for elapsed
;; time 1.05 h (01:03), CEQ for clock time 02:03. Each should act once, at the
;; first rule evaluation that covers its time.

[OPTIONS]
FLOW_UNITS           CFS
FLOW_ROUTING         DYNWAVE
START_DATE           01/01/2020
START_TIME           00:00:00
REPORT_START_DATE    01/01/2020
REPORT_START_TIME    00:00:00
END_DATE             01/01/2020
END_TIME             03:00:00
ROUTING_STEP         30
RULE_STEP            00:05:00
REPORT_STEP          00:05:00
VARIABLE_STEP        0

[JUNCTIONS]
;;Name Elev MaxDepth InitDepth SurDepth Aponded
J1     100  10       2         0        0
J2     99   10       0         0        0

[OUTFALLS]
O1     97   FREE     NO

[ORIFICES]
OR1    J1   J2  SIDE  0  0.65  NO  0

[CONDUITS]
C1     J2   O1  400   0.013  0  0  0  0

[XSECTIONS]
OR1    RECT_CLOSED  1.0  1.0  0  0
C1     CIRCULAR     1.5  0    0  0  1

[INFLOWS]
J1     FLOW  ""  FLOW  1.0  1.0  2.0

[CONTROLS]
RULE TEQ
IF SIMULATION TIME = 1.05
THEN ORIFICE OR1 SETTING = 0.2

RULE CEQ
IF SIMULATION CLOCKTIME = 02:03:00
THEN ORIFICE OR1 SETTING = 0.5

[REPORT]
INPUT NO
CONTROLS YES
