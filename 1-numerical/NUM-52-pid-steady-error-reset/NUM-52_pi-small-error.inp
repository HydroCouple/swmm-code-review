[TITLE]
NUM-52: PI controller facing a small constant error, ROUTING_STEP 30 s
;; SU1 is an isolated storage unit held at 1.01 ft. The rule asks for 1 ft, so the
;; relative error is (1 - 1.01)/1 = -0.01 at every evaluation and never changes.
;; PI 0.1 10 0: a P step of -0.001, then integral action of kp*e/ki = -0.0001 per minute.

[OPTIONS]
FLOW_UNITS           CFS
FLOW_ROUTING         DYNWAVE
START_DATE           01/01/2020
START_TIME           00:00:00
REPORT_START_DATE    01/01/2020
REPORT_START_TIME    00:00:00
END_DATE             01/01/2020
END_TIME             00:30:00
ROUTING_STEP         30
RULE_STEP            0
REPORT_STEP          00:01:00
VARIABLE_STEP        0

[JUNCTIONS]
;;Name Elev MaxDepth InitDepth SurDepth Aponded
J1     100  10       2         0        0
J2     99   10       0         0        0

[STORAGE]
;;Name Elev MaxDepth InitDepth Shape      Coeff Expon Const
SU1    90   10       1.01      FUNCTIONAL 0     0     100   0  0

[OUTFALLS]
O1     97   FREE     NO

[ORIFICES]
OR1    J1   J2  SIDE  0  0.65  NO  0

[CONDUITS]
C1     J2   O1  400   0.013  0  0  0  0

[XSECTIONS]
OR1    RECT_CLOSED  1.0  1.0  0  0
C1     CIRCULAR     1.5  0    0  0  1

[INFLOWS]
J1     FLOW  ""  FLOW  1.0  1.0  2.0

[CONTROLS]
RULE PIDP
IF NODE SU1 DEPTH <> 1
THEN ORIFICE OR1 SETTING = PID 0.1 10 0

[REPORT]
INPUT NO
CONTROLS YES
