[TITLE]
NUM-30: pervious runoff routed to the impervious area when PctZero = 100

[OPTIONS]
;; 1 acre, 50 % impervious. All of the impervious area has no depression
;; storage (PctZero = 100), so the IMPERV1 sub-area has zero area. All
;; pervious runoff is routed onto the impervious area. No infiltration and no
;; evaporation: every inch of rain must end up as runoff or surface storage.
FLOW_UNITS           CFS
INFILTRATION         HORTON
FLOW_ROUTING         KINWAVE
START_DATE           01/01/2020
START_TIME           00:00:00
REPORT_START_DATE    01/01/2020
REPORT_START_TIME    00:00:00
END_DATE             01/01/2020
END_TIME             12:00:00
WET_STEP             00:05:00
DRY_STEP             01:00:00
REPORT_STEP          00:05:00
ROUTING_STEP         0:00:30
IGNORE_ROUTING       YES

[EVAPORATION]
CONSTANT         0.0

[RAINGAGES]
;;Name  Format     Interval  SCF  Source
G1      INTENSITY  1:00      1.0  TIMESERIES  R1

[SUBCATCHMENTS]
;;Name  Gage  Outlet  Area  %Imperv  Width  %Slope  CurbLen
S1      G1    O1      1.0   50       100    1.0     0

[SUBAREAS]
;;Subcatch  N-Imperv  N-Perv  S-Imperv  S-Perv  PctZero  RouteTo     PctRouted
S1          0.01      0.1     0.05      0.05    100      IMPERVIOUS  100

[INFILTRATION]
;;Subcatch  MaxRate  MinRate  Decay  DryTime  MaxInfil
S1          0.0      0.0      4      7        0

[OUTFALLS]
;;Name  Elev  Type
O1      0     FREE

[TIMESERIES]
;; 1 in/hr for one hour: 1.0 in of rain
R1   0:00   1.0
R1   1:00   0.0

[REPORT]
SUBCATCHMENTS ALL
